# Secrets du bot. Ce fichier est un exemple: le vrai .env n'est jamais commite.
DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=

# Cle publique de l'application. Le bot passe par la passerelle et ne s'en sert pas ; elle
# n'est utile que pour verifier la signature Ed25519 d'un point d'entree HTTP "Interactions".
DISCORD_PUBLIC_KEY=

# Moodle: jeton d'un utilisateur de service, restreint au service
# "local_alphatrade_referral_bot" (Administration > Serveur > Services web).
ALPHATRADE_URL=https://www.alphatrade-academy.duckdns.org
ALPHATRADE_TOKEN=
