{{!
    @template local_alphatrade/backtesting

    Backtesting Lab: one card per strategy with two key metric lines.

    Example context (json):
    {
        "hascards": true,
        "cards": [{"name": "Alpha Setup #01", "market": "FX:EURUSD", "timeframe": "H1", "url": "#",
            "stats": {"trades": 52, "expectancy": "+0,32R", "expectancyclass": "alpha-value-positive", "winrate": "46 %", "maxdrawdown": "-6R"}}],
        "newurl": "#",
        "toolsurl": "#"
    }
}}
<div class="alpha-backtesting">
    <header class="alpha-pagehead">
        <div>
            <p class="alpha-eyebrow">{{#str}}backtestinglab, local_alphatrade{{/str}}</p>
            <h1 class="alpha-title">{{#str}}mystrategies, local_alphatrade{{/str}}</h1>
            <p class="alpha-lead">{{#str}}backtesting_lead, local_alphatrade{{/str}}</p>
        </div>
        <div class="alpha-pagehead-actions">
            <a class="btn btn-primary" href="{{newurl}}"><i class="ph ph-plus" aria-hidden="true"></i>{{#str}}new, local_alphatrade{{/str}}</a>
        </div>
    </header>

    {{#hascards}}
        <div class="alpha-grid alpha-grid-2">
            {{#cards}}
                <article class="alpha-card alpha-strategy-card">
                    <p class="alpha-card-caps">{{name}}</p>
                    <p class="alpha-muted alpha-strategy-market">{{market}} · {{timeframe}}</p>
                    <dl class="alpha-kv alpha-strategy-kv">
                        <div>
                            <dt>{{#str}}trades, local_alphatrade{{/str}}</dt>
                            <dd>{{stats.trades}}</dd>
                        </div>
                        <div>
                            <dt>{{#str}}expectancy, local_alphatrade{{/str}}</dt>
                            <dd class="{{stats.expectancyclass}}">{{stats.expectancy}}</dd>
                        </div>
                        <div>
                            <dt>{{#str}}winrate, local_alphatrade{{/str}}</dt>
                            <dd>{{stats.winrate}}</dd>
                        </div>
                        <div>
                            <dt>{{#str}}maxdrawdown, local_alphatrade{{/str}}</dt>
                            <dd>{{stats.maxdrawdown}}</dd>
                        </div>
                    </dl>
                    <div class="alpha-card-footer">
                        <span></span>
                        <a class="btn btn-secondary" href="{{url}}">
                            <span>{{#str}}open, local_alphatrade{{/str}}</span>
                            <i class="ph ph-arrow-right" aria-hidden="true"></i>
                        </a>
                    </div>
                </article>
            {{/cards}}
        </div>
    {{/hascards}}
    {{^hascards}}
        <div class="alpha-empty">
            <i class="ph ph-chart-line-up" aria-hidden="true"></i>
            <p>{{#str}}nostrategies, local_alphatrade{{/str}}</p>
            <a class="btn btn-primary" href="{{newurl}}"><i class="ph ph-plus" aria-hidden="true"></i>{{#str}}newstrategy, local_alphatrade{{/str}}</a>
        </div>
    {{/hascards}}
</div>
