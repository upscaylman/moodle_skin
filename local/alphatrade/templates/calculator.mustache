{{!
    @template local_alphatrade/calculator

    Tool screen (risk, position size, risk/reward), same patterns as the maquette forms.

    Example context (json):
    {
        "backurl": "#", "title": "Calculateur risque", "lead": "Calculer votre risque par trade", "action": "#", "tool": "risk",
        "inputs": [{"name": "capital", "label": "Capital", "value": "10000", "help": ""}],
        "hasresults": true, "results": [{"label": "Montant risqué", "value": "100", "main": true}], "warning": ""
    }
}}
<div class="at-screen at-calculator">
    <a href="{{backurl}}" class="at-back">&larr; {{#str}}tools, local_alphatrade{{/str}}</a>
    <h2 class="at-module-title">{{title}}</h2>
    <p class="at-module-desc">{{lead}}</p>
    <div class="at-calc-grid">
        <form class="at-card at-elev-sm at-pad-20" method="get" action="{{action}}">
            <input type="hidden" name="tool" value="{{tool}}">
            {{#inputs}}
                <div class="at-field at-mb-12">
                    <label for="at-calc-{{name}}">{{label}}</label>
                    <input class="at-input" id="at-calc-{{name}}" name="{{name}}" type="text" inputmode="decimal" value="{{value}}" required>
                    {{#help}}<div class="at-help">{{help}}</div>{{/help}}
                </div>
            {{/inputs}}
            <button type="submit" class="btn btn-primary">{{#str}}calculate, local_alphatrade{{/str}}</button>
        </form>
        <div class="at-card at-elev-sm at-pad-20" aria-live="polite">
            <span class="at-card-kicker">{{#str}}results, local_alphatrade{{/str}}</span>
            {{#hasresults}}
                <div class="at-strat-kv at-calc-results">
                    {{#results}}<div class="{{#main}}is-main{{/main}}"><span>{{label}}</span><span>{{value}}</span></div>{{/results}}
                </div>
            {{/hasresults}}
            {{^hasresults}}<p class="at-card-body">{{#str}}calculator_empty, local_alphatrade{{/str}}</p>{{/hasresults}}
            {{#warning}}<div class="at-note"><i class="ph ph-warning at-icon-warning" aria-hidden="true"></i>{{warning}}</div>{{/warning}}
        </div>
    </div>
</div>
