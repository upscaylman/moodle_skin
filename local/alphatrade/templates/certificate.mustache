{{!
    @template local_alphatrade/certificate

    Maquette Portail Etudiant, screen "Certification".

    Example context (json):
    {
        "fullname": "Julien Bouvier", "hasprogramme": true, "alldone": false, "downloadurl": "",
        "conditions": [{"label": "Cours complétés", "detail": "68 / 94", "iconclass": "ph-fill ph-check-circle", "statusclass": "at-status-done", "isdone": true}]
    }
}}
<div class="at-screen at-certificate">
    <div class="at-card at-elev-md at-cert-card">
        <i class="ph ph-graduation-cap at-cert-icon" aria-hidden="true"></i>
        <h3 class="at-mb-4">Alpha Trade</h3>
        <div class="at-cert-sub">{{#str}}certification_sub, local_alphatrade{{/str}}</div>
        <h4 class="at-mb-6">{{fullname}}</h4>
        <p class="at-card-body at-mb-18">{{#str}}certification_text, local_alphatrade{{/str}}</p>
        {{#hasprogramme}}
            <div class="at-checklist at-cert-list">
                {{#conditions}}
                    <div class="{{^isdone}}is-locked{{/isdone}}"><i class="{{iconclass}} {{statusclass}}" aria-hidden="true"></i>{{label}}{{#detail}} <span class="at-muted">· {{detail}}</span>{{/detail}}</div>
                {{/conditions}}
            </div>
        {{/hasprogramme}}
        {{#downloadurl}}<a class="btn btn-primary" href="{{downloadurl}}">{{#str}}downloadcertificate, local_alphatrade{{/str}}</a>{{/downloadurl}}
        {{^downloadurl}}
            <span class="btn btn-primary disabled" aria-disabled="true">{{#str}}downloadcertificate, local_alphatrade{{/str}}</span>
            <p class="at-cert-hint">{{#alldone}}{{#str}}certificatenotconfigured, local_alphatrade{{/str}}{{/alldone}}{{^alldone}}{{#str}}certificatelocked, local_alphatrade{{/str}}{{/alldone}}</p>
        {{/downloadurl}}
    </div>
</div>
