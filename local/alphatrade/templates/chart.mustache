{{!
    @template local_alphatrade/chart

    Maquette Portail Etudiant, screen "Analyse de graphique" (form, then trainer correction).

    Example context (json):
    {
        "backurl": "#", "number": "ANALYSE #017", "market": "EUR/USD · H1", "title": "Range asiatique",
        "chartsrc": "https://www.tradingview.com/widgetembed/?symbol=FX%3AEURUSD&interval=60",
        "instructions": "", "hasinstructions": false,
        "showform": true, "actionurl": "#", "sesskey": "x",
        "biases": [{"value": "bullish", "label": "Bullish", "checked": true}, {"value": "bearish", "label": "Bearish", "checked": false}],
        "structure": "", "liquidity": "", "scenario": ""
    }
}}
<div class="at-screen at-analyse">
    <a href="{{backurl}}" class="at-back">&larr; {{#str}}practicelab, local_alphatrade{{/str}}</a>
    <div class="at-eyebrow">{{number}}</div>
    <h3 class="at-analyse-market">{{market}}</h3>
    <div class="at-chartbox">
        <iframe src="{{chartsrc}}" title="{{market}} - TradingView" loading="lazy" referrerpolicy="no-referrer"></iframe>
    </div>
    {{#hasinstructions}}<div class="at-analyse-instructions">{{{instructions}}}</div>{{/hasinstructions}}

    {{#showform}}
        <h5 class="at-mb-14">{{#str}}youranalysis_upper, local_alphatrade{{/str}}</h5>
        <form method="post" action="{{actionurl}}">
            <input type="hidden" name="sesskey" value="{{sesskey}}">
            <div class="at-field at-mb-12 at-max-520">
                <label for="at-structure">{{#str}}analysis_structure, local_alphatrade{{/str}}</label>
                <input class="at-input" id="at-structure" name="structure" type="text" value="{{structure}}" required placeholder="{{#str}}analysis_structure_ph, local_alphatrade{{/str}}">
            </div>
            <div class="at-field at-mb-12 at-max-520">
                <label for="at-liquidity">{{#str}}analysis_liquidity, local_alphatrade{{/str}}</label>
                <input class="at-input" id="at-liquidity" name="liquidity" type="text" value="{{liquidity}}" placeholder="{{#str}}analysis_liquidity_ph, local_alphatrade{{/str}}">
            </div>
            <div class="at-field at-mb-12">
                <span class="at-label">{{#str}}analysis_bias, local_alphatrade{{/str}}</span>
                <div class="at-radio-row">
                    {{#biases}}
                        <label class="at-radio"><input type="radio" name="bias" value="{{value}}"{{#checked}} checked{{/checked}}><span class="at-dot"></span>{{label}}</label>
                    {{/biases}}
                </div>
            </div>
            <div class="at-field at-mb-18 at-max-520">
                <label for="at-scenario">{{#str}}analysis_scenario, local_alphatrade{{/str}}</label>
                <input class="at-input" id="at-scenario" name="scenario" type="text" value="{{scenario}}" required placeholder="{{#str}}analysis_scenario_ph, local_alphatrade{{/str}}">
            </div>
            <button type="submit" class="btn btn-primary">{{#str}}submitanalysis, local_alphatrade{{/str}}</button>
        </form>
    {{/showform}}

    {{#submission}}
        {{^isreviewed}}
            <div class="at-card at-elev-sm at-pad-22 at-max-480">
                <span class="at-card-kicker">{{#str}}analysis_submitted, local_alphatrade{{/str}}</span>
                <h4 class="at-card-title at-mt-2">{{#str}}analysis_waiting_title, local_alphatrade{{/str}}</h4>
                <div class="at-answers">
                    <div><span>{{#str}}analysis_structure, local_alphatrade{{/str}}</span>{{{structure}}}</div>
                    <div><span>{{#str}}analysis_liquidity, local_alphatrade{{/str}}</span>{{{liquidity}}}</div>
                    <div><span>{{#str}}analysis_bias, local_alphatrade{{/str}}</span>{{bias}}</div>
                    <div><span>{{#str}}analysis_scenario, local_alphatrade{{/str}}</span>{{{scenario}}}</div>
                </div>
                {{#editurl}}<a class="btn btn-secondary" href="{{editurl}}">{{#str}}editanalysis, local_alphatrade{{/str}}</a>{{/editurl}}
            </div>
        {{/isreviewed}}
        {{#isreviewed}}
            <div class="at-card at-elev-sm at-pad-22 at-max-480">
                <span class="at-card-kicker">{{#str}}correctiontitle, local_alphatrade{{/str}}</span>
                <h4 class="at-card-title at-mt-2">{{#str}}correctionsubtitle, local_alphatrade{{/str}}</h4>
                <div class="at-criteria">
                    {{#criteria}}
                        <div>{{name}} - <i class="{{icon}} {{colorclass}}" aria-hidden="true"></i><span class="sr-only">{{label}}</span></div>
                    {{/criteria}}
                </div>
                {{#hasfeedback}}<p class="at-card-body">{{{feedback}}}</p>{{/hasfeedback}}
                <div class="at-analyse-score">{{score}} / 100</div>
            </div>
            {{#hascorrection}}
                <div class="at-card at-elev-sm at-pad-22 at-mt-16">
                    <span class="at-card-kicker">{{#str}}referencecorrection, local_alphatrade{{/str}}</span>
                    <div class="at-card-body">{{{correction}}}</div>
                </div>
            {{/hascorrection}}
        {{/isreviewed}}
    {{/submission}}
</div>
