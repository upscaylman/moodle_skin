{{!
    @template local_alphatrade/charts

    Chart analysis exercises, cards in the Backtesting list style of the maquette.

    Example context (json):
    {
        "backurl": "#", "hascards": true, "canmanage": false, "newurl": "#", "reviewsurl": "",
        "cards": [{"number": "ANALYSE #017", "title": "Range asiatique", "market": "EUR/USD · H1", "url": "#", "editurl": "", "hidden": false,
            "tag": {"class": "at-tag-neutral", "label": "À faire", "icon": ""} }]
    }
}}
<div class="at-screen at-charts">
    <a href="{{backurl}}" class="at-back">&larr; {{#str}}practicelab, local_alphatrade{{/str}}</a>
    <div class="at-row-between at-mb-18">
        <h2 class="at-m-0">{{#str}}practice_charts, local_alphatrade{{/str}}</h2>
        <div class="at-row-gap-10">
            {{#reviewsurl}}<a class="btn btn-secondary" href="{{reviewsurl}}">{{#str}}reviews, local_alphatrade{{/str}}</a>{{/reviewsurl}}
            {{#canmanage}}<a class="btn btn-primary" href="{{newurl}}">+ {{#str}}newchart, local_alphatrade{{/str}}</a>{{/canmanage}}
        </div>
    </div>
    {{#hascards}}
        <div class="at-stack-14">
            {{#cards}}
                <div class="at-card at-elev-sm at-pad-20">
                    <div class="at-eyebrow">{{number}}{{#hidden}} · {{#str}}hidden, local_alphatrade{{/str}}{{/hidden}}</div>
                    <h4 class="at-card-title">{{market}}</h4>
                    <div class="at-card-meta at-mb-10">{{title}}</div>
                    <div class="at-mb-14"><span class="at-tag {{tag.class}}">{{#tag.icon}}<i class="{{tag.icon}}" aria-hidden="true"></i>{{/tag.icon}}{{tag.label}}</span></div>
                    <a class="btn btn-secondary" href="{{url}}">{{#str}}open, local_alphatrade{{/str}}</a>
                    {{#editurl}}<a class="btn btn-ghost" href="{{editurl}}">{{#str}}edit{{/str}}</a>{{/editurl}}
                </div>
            {{/cards}}
        </div>
    {{/hascards}}
    {{^hascards}}<p class="at-muted">{{#str}}nocharts, local_alphatrade{{/str}}</p>{{/hascards}}
</div>
