{{!
    @template local_alphatrade/community

    Community: 3 full-width cards and the "no signals" notice.

    Example context (json):
    {
        "hascards": true,
        "cards": [{"icon": "ph-megaphone", "title": "Annonces Alpha Trade", "text": "Informations officielles des formateurs", "url": "#", "meta": "12 discussions", "rule": ""}]
    }
}}
<div class="alpha-community">
    <header class="alpha-pagehead">
        <div>
            <p class="alpha-eyebrow">{{#str}}community, local_alphatrade{{/str}}</p>
            <h1 class="alpha-title">{{#str}}community_title, local_alphatrade{{/str}}</h1>
            <p class="alpha-lead">{{#str}}community_lead, local_alphatrade{{/str}}</p>
        </div>
    </header>

    {{#hascards}}
        <div class="alpha-stack">
            {{#cards}}
                <a class="alpha-card alpha-card-link alpha-community-card" href="{{url}}">
                    <span class="alpha-card-icon"><i class="ph {{icon}}" aria-hidden="true"></i></span>
                    <span class="alpha-community-body">
                        <span class="alpha-card-caps">{{title}}</span>
                        <span class="alpha-card-text">{{text}}</span>
                        {{#rule}}<span class="alpha-status alpha-status-warning"><i class="ph ph-shield-warning" aria-hidden="true"></i>{{rule}}</span>{{/rule}}
                    </span>
                    <span class="alpha-community-aside">
                        <span class="alpha-subtle">{{meta}}</span>
                        <span class="alpha-link-cta">{{#str}}open, local_alphatrade{{/str}} <i class="ph ph-arrow-right" aria-hidden="true"></i></span>
                    </span>
                </a>
            {{/cards}}
        </div>
    {{/hascards}}
    {{^hascards}}
        <div class="alpha-empty">
            <i class="ph ph-users-three" aria-hidden="true"></i>
            <p>{{#str}}nocommunity, local_alphatrade{{/str}}</p>
        </div>
    {{/hascards}}

    <div class="alpha-banner alpha-banner-warning alpha-community-notice">
        <i class="ph ph-warning" aria-hidden="true"></i>
        <div><strong>{{#str}}nosignals, local_alphatrade{{/str}}</strong></div>
    </div>
</div>
