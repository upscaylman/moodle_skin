{{!
    @template local_alphatrade/community

    Maquette Portail Etudiant, screen "Communauté".

    Example context (json):
    {"hascards": true, "cards": [{"icon": "ph-megaphone", "title": "Annonces Alpha Trade", "text": "Informations officielles des formateurs", "url": "#", "meta": "12 discussions"}],
    "hasposts": true, "posts": [{"initials": "LR", "author": "Léa R.", "forum": "Questions", "excerpt": "Différence entre un FVG et un order block ?", "time": "Il y a 2h", "url": "#"}]}
}}
<div class="at-screen at-community">
    <h2 class="at-mb-18">{{#str}}community, local_alphatrade{{/str}}</h2>
    {{#hascards}}
        <div class="at-stack-14 at-mb-18">
            {{#cards}}
                <div class="at-card at-elev-sm at-list-card at-pad-20">
                    <div class="at-list-card-main is-community">
                        <i class="ph {{icon}}" aria-hidden="true"></i>
                        <div>
                            <h4 class="at-card-title">{{title}}</h4>
                            <p class="at-card-body">{{text}}{{#meta}} · {{meta}}{{/meta}}</p>
                        </div>
                    </div>
                    <a class="btn btn-secondary" href="{{url}}">{{#str}}open, local_alphatrade{{/str}} &rarr;</a>
                </div>
            {{/cards}}
        </div>
    {{/hascards}}
    {{^hascards}}<p class="at-muted at-mb-18">{{#str}}nocommunity, local_alphatrade{{/str}}</p>{{/hascards}}
    {{#hasposts}}
        <h4 class="at-mb-12">{{#str}}latestposts, local_alphatrade{{/str}}</h4>
        <div class="at-stack-14 at-max-640 at-mb-18">
            {{#posts}}
                <div class="at-card at-elev-sm at-post">
                    <div class="at-post-head"><span class="at-avatar at-avatar-30" aria-hidden="true">{{initials}}</span><strong>{{author}}</strong><span class="at-tag at-tag-neutral">{{forum}}</span><span class="at-muted">{{time}}</span></div>
                    <p>{{excerpt}}</p>
                    <a class="btn btn-ghost" href="{{url}}">{{#str}}reply, local_alphatrade{{/str}}</a>
                </div>
            {{/posts}}
        </div>
    {{/hasposts}}
    <div class="at-note"><i class="ph ph-warning at-icon-warning" aria-hidden="true"></i>{{#str}}nosignals, local_alphatrade{{/str}}</div>
</div>
