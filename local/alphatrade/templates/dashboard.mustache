{{!
    @template local_alphatrade/dashboard

    Maquette Portail Etudiant, screen "Accueil".

    Example context (json):
    {
        "greeting": "Bonjour Julien", "hasprogramme": true, "percent": 62, "week": "Semaine 7 / 12",
        "continue": {"title": "Module 03 - Structure de marché", "item": "Leçon 07 - Étude de cas", "url": "#", "cta": "Continuer la leçon"},
        "modules": [
            {"number": "01", "name": "Fondamentaux des marchés", "url": "#", "islocked": false, "iconclass": "ph-fill ph-check-circle", "statusclass": "at-status-done", "statuslabel": "Terminé"},
            {"number": "04", "name": "ICT / SMC", "url": "#", "islocked": true, "iconclass": "ph ph-lock-simple", "statusclass": "at-status-locked", "statuslabel": "Verrouillé"}
        ],
        "streak": "4 jours", "trades": 127, "badges": 6, "isadmin": false, "settingsurl": "#"
    }
}}
<div class="at-screen at-dashboard">
    <p class="at-greeting">{{greeting}}</p>

    {{^hasprogramme}}
        <div class="at-card at-elev-sm at-pad-20 at-mb-20">
            <span class="at-card-kicker">{{#str}}parcours, local_alphatrade{{/str}}</span>
            <p class="at-card-body">{{#str}}noprogramme, local_alphatrade{{/str}}</p>
            {{#isadmin}}<a class="btn btn-primary" href="{{settingsurl}}">{{#str}}configureprogramme, local_alphatrade{{/str}} &rarr;</a>{{/isadmin}}
        </div>
    {{/hasprogramme}}

    {{#hasprogramme}}
        <div class="at-card at-elev-sm at-pad-20 at-mb-16">
            <span class="at-card-kicker">{{#str}}yourprogress, local_alphatrade{{/str}}</span>
            <div class="at-dash-percent">{{percent}} %</div>
            <div class="at-progress at-mb-8" role="progressbar" aria-valuenow="{{percent}}" aria-valuemin="0" aria-valuemax="100"><span style="width: {{percent}}%"></span></div>
            <div class="at-dash-week">{{week}}</div>
        </div>

        {{#continue}}
            <div class="at-card at-elev-sm at-pad-20 at-mb-20">
                <span class="at-card-kicker at-kicker-icon"><i class="ph-fill ph-play-circle" aria-hidden="true"></i>{{#str}}continue, local_alphatrade{{/str}}</span>
                <h3 class="at-card-title at-mt-2">{{title}}</h3>
                <p class="at-card-body">{{item}}</p>
                <a class="btn btn-primary" href="{{url}}">{{cta}} &rarr;</a>
            </div>
        {{/continue}}

        <h4 class="at-dash-h4">{{#str}}yourparcours, local_alphatrade{{/str}}</h4>
        <div class="at-dash-tiles">
            {{#modules}}
                <a class="at-dash-tile{{#islocked}} is-locked{{/islocked}}" href="{{url}}">
                    <div class="at-dash-tile-n">{{number}}</div>
                    <div class="at-dash-tile-title"><i class="{{iconclass}} {{statusclass}}" aria-hidden="true"></i><span>{{name}}</span><span class="sr-only"> ({{statuslabel}})</span></div>
                </a>
            {{/modules}}
        </div>
    {{/hasprogramme}}

    <div class="at-dash-stats">
        <div class="at-card at-elev-sm at-stat-center">
            <i class="ph ph-flame at-stat-icon is-warning" aria-hidden="true"></i>
            <div class="at-stat-value">{{streak}}</div>
            <div class="at-stat-label">{{#str}}streak, local_alphatrade{{/str}}</div>
        </div>
        <div class="at-card at-elev-sm at-stat-center">
            <i class="ph ph-flask at-stat-icon" aria-hidden="true"></i>
            <div class="at-stat-value">{{trades}}</div>
            <div class="at-stat-label">{{#str}}backtestedtrades, local_alphatrade{{/str}}</div>
        </div>
        <div class="at-card at-elev-sm at-stat-center">
            <i class="ph ph-trophy at-stat-icon" aria-hidden="true"></i>
            <div class="at-stat-value">{{badges}}</div>
            <div class="at-stat-label">{{#str}}badges, local_alphatrade{{/str}}</div>
        </div>
    </div>
</div>
