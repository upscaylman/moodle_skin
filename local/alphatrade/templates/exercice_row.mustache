{{!
    @template local_alphatrade/exercice_row

    One exercise row of the Exercices screen (devoir or quiz).

    Example context (json):
    {"name": "Exercice 1.1 — Cartographie des actifs", "url": "#", "modulename": "Module 1 — Fondamentaux",
     "modulenumber": "02", "islocked": false, "isquiz": false, "icon": "ph-clipboard-text",
     "status": "À faire", "grade": "12,0 / 20,0"}
}}
<div class="at-card at-elev-sm at-pad-22 at-exrow{{#islocked}} is-locked{{/islocked}}">
    <span class="at-exrow-icon" aria-hidden="true"><i class="ph {{icon}}"></i></span>
    <div class="at-exrow-body">
        {{#islocked}}<span class="at-exrow-name">{{name}}</span>{{/islocked}}
        {{^islocked}}<a class="at-exrow-name" href="{{url}}">{{name}}</a>{{/islocked}}
        <span class="at-exrow-meta">{{moduletitle}}</span>
    </div>
    <div class="at-exrow-side">
        {{#grade}}<span class="at-exrow-grade">{{grade}}</span>{{/grade}}
        {{#islocked}}<span class="at-tag at-tag-neutral"><i class="ph ph-lock-simple" aria-hidden="true"></i>{{#str}}locked, local_alphatrade{{/str}}</span>{{/islocked}}
        {{^islocked}}<span class="at-tag at-tag-neutral">{{status}}</span>{{/islocked}}
    </div>
</div>
