{{!
    @template local_alphatrade/exercices

    Pilier Exercices : à faire · en attente de correction · terminés.

    Example context (json):
    {
        "hastodo": true, "counttodo": 2,
        "todo": [{"name": "Exercice 1.1", "url": "#", "modulename": "Module 1", "modulenumber": "02",
            "islocked": false, "isquiz": false, "icon": "ph-clipboard-text", "status": "À faire", "grade": ""}],
        "haswaiting": false, "countwaiting": 0, "waiting": [],
        "hasdone": false, "countdone": 0, "done": []
    }
}}
<div class="at-screen at-exercices">
    <section class="at-mb-18">
        <h3 class="at-eyebrow at-mb-12">{{#str}}ex_group_todo, local_alphatrade{{/str}}{{#counttodo}} · {{counttodo}}{{/counttodo}}</h3>
        {{#hastodo}}
            <div class="at-stack-14">
                {{#todo}}
                    {{> local_alphatrade/exercice_row }}
                {{/todo}}
            </div>
        {{/hastodo}}
        {{^hastodo}}
            <div class="at-card at-elev-sm at-pad-22 at-empty-card">
                <i class="ph ph-check-circle at-empty-icon" aria-hidden="true"></i>
                <p class="at-card-body at-m-0">{{#str}}ex_empty_todo, local_alphatrade{{/str}}</p>
            </div>
        {{/hastodo}}
    </section>

    {{#haswaiting}}
        <section class="at-mb-18">
            <h3 class="at-eyebrow at-mb-12">{{#str}}ex_group_waiting, local_alphatrade{{/str}} · {{countwaiting}}</h3>
            <div class="at-stack-14">
                {{#waiting}}
                    {{> local_alphatrade/exercice_row }}
                {{/waiting}}
            </div>
        </section>
    {{/haswaiting}}

    {{#hasdone}}
        <section>
            <h3 class="at-eyebrow at-mb-12">{{#str}}ex_group_done, local_alphatrade{{/str}} · {{countdone}}</h3>
            <div class="at-stack-14">
                {{#done}}
                    {{> local_alphatrade/exercice_row }}
                {{/done}}
            </div>
        </section>
    {{/hasdone}}
</div>
