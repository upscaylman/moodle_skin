{{!
    @template local_alphatrade/item_row

    One lesson / activity row with its state (done, current, to do, locked).

    Example context (json):
    {
        "number": "01", "name": "HH, HL, LH, LL", "url": "#", "icon": "ph-article",
        "isdone": false, "iscurrent": true, "islocked": false, "istodo": false,
        "statusicon": "ph-fill ph-play-circle", "statuslabel": "En cours", "availableinfo": ""
    }
}}
{{#islocked}}
    <div class="alpha-list-item is-locked">
        <span class="alpha-state-icon is-locked"><i class="{{statusicon}}" aria-hidden="true"></i></span>
        {{#number}}<span class="alpha-list-num">{{number}}</span>{{/number}}
        <span class="alpha-list-body">
            <span class="alpha-list-title">{{name}}</span>
            {{#availableinfo}}<span class="alpha-list-meta">{{{availableinfo}}}</span>{{/availableinfo}}
        </span>
        <span class="alpha-status alpha-status-locked"><i class="ph ph-lock-simple" aria-hidden="true"></i>{{statuslabel}}</span>
    </div>
{{/islocked}}
{{^islocked}}
    <a class="alpha-list-item{{#iscurrent}} is-current{{/iscurrent}}" href="{{url}}">
        <span class="alpha-state-icon{{#isdone}} is-done{{/isdone}}{{#iscurrent}} is-current{{/iscurrent}}{{#istodo}} is-todo{{/istodo}}">
            <i class="{{statusicon}}" aria-hidden="true"></i>
        </span>
        {{#number}}<span class="alpha-list-num">{{number}}</span>{{/number}}
        <span class="alpha-list-body">
            <span class="alpha-list-title">{{name}}</span>
        </span>
        <span class="alpha-list-aside">
            <i class="ph {{icon}}" aria-hidden="true"></i>
            {{#isdone}}<span class="alpha-status alpha-status-success"><i class="ph ph-check" aria-hidden="true"></i>{{statuslabel}}</span>{{/isdone}}
            {{#iscurrent}}<span class="alpha-status alpha-status-accent"><i class="ph ph-circle-half" aria-hidden="true"></i>{{statuslabel}}</span>{{/iscurrent}}
        </span>
    </a>
{{/islocked}}
