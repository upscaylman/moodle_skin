{{!
    @template local_alphatrade/journal

    Maquette Portail Etudiant, screen "Journal".

    Example context (json):
    {
        "isown": true, "addurl": "#",
        "tags": [{"label": "Toutes", "url": "#", "active": true}, {"label": "Forex", "url": "#", "active": false}],
        "hasrows": true,
        "rows": [{"date": "12/09", "url": "#", "asset": "EUR/USD", "setup": "Alpha #01", "result": "+3R", "resultclass": "at-positive", "hasemotion": true, "emotion": "Neutre", "emotionicon": "ph-smiley-meh"}],
        "week": "Cette semaine - 12 trades · +4.5R · 58 % win rate"
    }
}}
<div class="at-screen at-journal">
    <div class="at-row-between at-mb-16">
        <h2 class="at-m-0">{{#str}}journal_title, local_alphatrade{{/str}}</h2>
        {{#isown}}<a class="btn btn-primary" href="{{addurl}}">+ {{#str}}add, local_alphatrade{{/str}}</a>{{/isown}}
    </div>
    <div class="at-tags at-mb-16">
        {{#tags}}<a class="at-tag {{#active}}at-tag-accent{{/active}}{{^active}}at-tag-neutral{{/active}}" href="{{url}}"{{#active}} aria-current="true"{{/active}}>{{label}}</a>{{/tags}}
    </div>
    <div class="at-card at-elev-sm at-table-card at-mb-14">
        <table class="at-table">
            <thead><tr><th>{{#str}}date, local_alphatrade{{/str}}</th><th>{{#str}}asset, local_alphatrade{{/str}}</th><th>{{#str}}setup, local_alphatrade{{/str}}</th><th>{{#str}}result, local_alphatrade{{/str}}</th><th>{{#str}}state, local_alphatrade{{/str}}</th></tr></thead>
            <tbody>
                {{#rows}}
                    <tr class="at-rowlink">
                        <td><a href="{{url}}">{{date}}</a></td>
                        <td>{{asset}}</td>
                        <td>{{setup}}</td>
                        <td class="{{resultclass}}">{{result}}</td>
                        <td>{{#hasemotion}}<i class="ph {{emotionicon}}" title="{{emotion}}" aria-label="{{emotion}}"></i>{{/hasemotion}}</td>
                    </tr>
                {{/rows}}
                {{^hasrows}}<tr><td colspan="5" class="at-muted">{{#str}}nojournal, local_alphatrade{{/str}}</td></tr>{{/hasrows}}
            </tbody>
        </table>
    </div>
    <div class="at-meta13">{{week}}</div>
</div>
