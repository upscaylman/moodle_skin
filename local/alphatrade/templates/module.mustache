{{!
    @template local_alphatrade/module

    Maquette Portail Etudiant, screen "Module".

    Example context (json):
    {
        "parcoursurl": "#", "label": "MODULE 03", "name": "Structure de marché",
        "description": "Comprendre le comportement du prix avant de chercher à anticiper son mouvement.",
        "percent": 75, "lessonsprogress": "6 / 8 leçons",
        "rows": [
            {"number": "06", "name": "Market Structure Shift", "url": "#", "islocked": false, "iscurrent": false, "iconclass": "ph-fill ph-check-circle", "statusclass": "at-status-done", "availableinfo": ""},
            {"number": "07", "name": "Étude de cas", "url": "#", "islocked": false, "iscurrent": true, "iconclass": "ph-fill ph-circle", "statusclass": "at-status-current", "availableinfo": ""},
            {"number": "08", "name": "Évaluation", "url": "", "islocked": true, "iscurrent": false, "iconclass": "ph ph-lock-simple", "statusclass": "at-status-locked", "availableinfo": ""}
        ],
        "islocked": false, "availableinfo": "",
        "hasobjectives": true, "objectives": [{"text": "Identifier une tendance"}], "objectivesdone": true,
        "canedit": false, "editurl": "#"
    }
}}
<div class="at-screen at-module">
    <a href="{{parcoursurl}}" class="at-back">&larr; {{#str}}backtoparcours, local_alphatrade{{/str}}</a>
    <div class="at-eyebrow">{{label}}</div>
    <h2 class="at-module-title">{{name}}</h2>
    {{#description}}<p class="at-module-desc">{{description}}</p>{{/description}}
    {{#islocked}}
        <p class="at-module-locked"><i class="ph ph-lock-simple" aria-hidden="true"></i> {{#str}}modulelocked, local_alphatrade{{/str}}{{#availableinfo}} - {{{availableinfo}}}{{/availableinfo}}</p>
    {{/islocked}}
    <div class="at-progress at-mb-6"><span style="width: {{percent}}%"></span></div>
    <div class="at-module-count">{{lessonsprogress}}</div>
    <div class="at-card at-elev-sm at-lesson-list">
        {{#rows}}
            {{#islocked}}
                <div class="at-lesson-row is-locked"><i class="{{iconclass}} {{statusclass}}" aria-hidden="true"></i>{{number}} - {{name}}</div>
            {{/islocked}}
            {{^islocked}}
                <a class="at-lesson-row{{#iscurrent}} is-current{{/iscurrent}}" href="{{url}}"><i class="{{iconclass}} {{statusclass}}" aria-hidden="true"></i>{{number}} - {{name}}</a>
            {{/islocked}}
        {{/rows}}
    </div>
    {{#hasobjectives}}
        <h5 class="at-mb-10">{{#str}}objectives_upper, local_alphatrade{{/str}}</h5>
        <div class="at-checklist">
            {{#objectives}}
                {{! Les objectifs decrivent ce que couvre le module : la maquette les coche toujours. }}
                <div><i class="ph-fill ph-check-circle at-status-done" aria-hidden="true"></i>{{text}}</div>
            {{/objectives}}
        </div>
    {{/hasobjectives}}
    {{#canedit}}
        <p class="at-mt-22"><a class="btn btn-secondary" href="{{editurl}}"><i class="ph ph-pencil-simple" aria-hidden="true"></i>{{#str}}editinmoodle, local_alphatrade{{/str}}</a></p>
    {{/canedit}}
</div>
