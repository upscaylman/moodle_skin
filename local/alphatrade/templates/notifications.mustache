{{!
    @template local_alphatrade/notifications

    Maquette Messagerie, tab "Notifications".

    Example context (json):
    {
        "hasunread": true, "readallurl": "#", "hasrows": true,
        "rows": [{"text": "Correction reçue sur votre dernier exercice", "when": "Hier, 16:20", "url": "#", "isunread": true}]
    }
}}
<div class="at-screen at-notifs">
    <div class="at-row-between at-mb-18">
        <h3 class="at-m-0">{{#str}}notifications, message{{/str}}</h3>
        {{#hasunread}}<a class="btn btn-ghost" href="{{readallurl}}">{{#str}}markallread, local_alphatrade{{/str}}</a>{{/hasunread}}
    </div>
    <div class="at-notif-list">
        {{#rows}}
            <div class="at-notif{{#isunread}} is-unread{{/isunread}}">
                <span class="at-notif-dot" aria-hidden="true"></span>
                <div>
                    <div class="at-notif-text">{{#url}}<a href="{{url}}">{{text}}</a>{{/url}}{{^url}}{{text}}{{/url}}{{#isunread}}<span class="sr-only"> ({{#str}}unread, local_alphatrade{{/str}})</span>{{/isunread}}</div>
                    <div class="at-notif-when">{{when}}</div>
                </div>
            </div>
        {{/rows}}
        {{^hasrows}}<div class="at-empty">{{#str}}nonotifications, local_alphatrade{{/str}}</div>{{/hasrows}}
    </div>
</div>
