{{!
    @template local_alphatrade/parcours

    Maquette Portail Etudiant, screen "Parcours": months, module cards, locked modules as a line.

    Example context (json):
    {
        "hasprogramme": true, "percent": 62,
        "months": [{"number": 2, "label": "MOIS 2", "theme": "ANALYSER", "modules": [
            {"number": "03", "name": "Structure de marché", "url": "#", "meta": "8 leçons · 75 %", "islocked": false, "iscurrent": true, "iconclass": "ph-fill ph-circle", "statusclass": "at-status-current"},
            {"number": "04", "name": "ICT / SMC", "url": "#", "meta": "9 leçons · 0 %", "islocked": true, "iscurrent": false, "iconclass": "ph ph-lock-simple", "statusclass": "at-status-locked"}
        ]}]
    }
}}
<div class="at-screen at-parcours">
    {{^hasprogramme}}
        <p class="at-muted">{{#str}}noprogramme, local_alphatrade{{/str}}</p>
    {{/hasprogramme}}
    {{#hasprogramme}}
        <div class="at-parcours-label">{{#str}}programmetitle, local_alphatrade{{/str}}</div>
        <div class="at-progress at-mb-26"><span style="width: {{percent}}%"></span></div>
        {{#months}}
            <div class="at-month">
                <div class="at-eyebrow at-mb-2">{{label}}</div>
                <div class="at-month-theme">{{theme}}</div>
                <div class="at-month-list">
                    {{#modules}}
                        {{#islocked}}
                            <div class="at-module-line"><i class="ph ph-lock-simple" aria-hidden="true"></i> {{label}} - {{name}}</div>
                        {{/islocked}}
                        {{^islocked}}
                            <a class="at-card at-elev-sm at-module-card" href="{{url}}">
                                <div>
                                    <div class="at-module-card-title"><i class="{{iconclass}} {{statusclass}}" aria-hidden="true"></i>{{label}} - {{name}}</div>
                                    <div class="at-module-card-meta">{{meta}}</div>
                                </div>
                                {{#iscurrent}}<span class="btn btn-primary">{{#str}}continue, local_alphatrade{{/str}} &rarr;</span>{{/iscurrent}}
                            </a>
                        {{/islocked}}
                    {{/modules}}
                </div>
            </div>
        {{/months}}
    {{/hasprogramme}}
</div>
