{{!
    @template local_alphatrade/parcours

    Maquette Portail Etudiant, screen "Parcours": months, module cards, locked modules as a line.

    Example context (json):
    {
        "hasprogramme": true, "percent": 62,
        "months": [{"number": 2, "label": "MOIS 2", "theme": "ANALYSER", "modules": [
            {"number": "03", "name": "Structure de marché", "url": "#", "meta": "8 leçons · 75 %", "islocked": false, "iscurrent": true, "iconclass": "ph-fill ph-circle", "statusclass": "at-status-current"},
            {"number": "04", "name": "ICT / SMC", "url": "#", "meta": "9 leçons · 0 %", "islocked": true, "iscurrent": false, "iconclass": "ph ph-lock-simple", "statusclass": "at-status-locked"}
        ]}]
    }
}}
<div class="at-screen at-parcours">
    {{^hasprogramme}}
        <p class="at-muted">{{#str}}noprogramme, local_alphatrade{{/str}}</p>
    {{/hasprogramme}}
    {{#hasprogramme}}
        <div class="at-parcours-label">{{#str}}programmetitle, local_alphatrade{{/str}}</div>
        <div class="at-progress at-mb-26"><span style="width: {{percent}}%"></span></div>
        {{! Une seule carte par mois : les modules sont des lignes a l'interieur, jamais des cartes. }}
        {{#months}}
            <div class="at-month">
                <div class="at-eyebrow at-mb-2">{{label}}</div>
                <div class="at-card at-elev-sm at-month-card">
                    <div class="at-month-theme">{{theme}}</div>
                    <div class="at-month-list">
                        {{#modules}}
                            {{#islocked}}
                                <div class="at-modrow is-locked">
                                    <span class="at-modrow-dot is-locked" aria-hidden="true"></span>
                                    <span class="at-modrow-body">
                                        <span class="at-modrow-title">{{number}} - {{name}}</span>
                                        <span class="at-modrow-meta">{{meta}}</span>
                                    </span>
                                    <span class="at-modrow-status is-locked">{{#str}}status_locked, local_alphatrade{{/str}}</span>
                                </div>
                            {{/islocked}}
                            {{^islocked}}
                                <a class="at-modrow" href="{{url}}">
                                    <span class="at-modrow-dot{{#isdone}} is-done{{/isdone}}" aria-hidden="true"></span>
                                    <span class="at-modrow-body">
                                        <span class="at-modrow-title">{{number}} - {{name}}</span>
                                        <span class="at-modrow-meta">{{meta}}</span>
                                    </span>
                                    {{#iscurrent}}<span class="btn btn-primary at-modrow-cta">{{#str}}continue, local_alphatrade{{/str}} &rarr;</span>{{/iscurrent}}
                                    {{^iscurrent}}{{#isdone}}<span class="at-modrow-status is-done">{{#str}}status_done, local_alphatrade{{/str}}</span>{{/isdone}}{{/iscurrent}}
                                </a>
                            {{/islocked}}
                        {{/modules}}
                    </div>
                </div>
            </div>
        {{/months}}
    {{/hasprogramme}}
</div>
