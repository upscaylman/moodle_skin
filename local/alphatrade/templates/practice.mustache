{{!
    @template local_alphatrade/practice

    Maquette Portail Etudiant, screen "Pratique".

    Example context (json):
    {"cards": [{"icon": "ph-chart-line-up", "title": "Graphiques", "text": "Analysez des situations de marché", "cta": "Commencer", "url": "#", "primary": true}]}
}}
<div class="at-screen at-practice">
    <h2 class="at-mb-6">{{#str}}practicelab, local_alphatrade{{/str}}</h2>
    <p class="at-practice-lead">{{#str}}practice_title, local_alphatrade{{/str}}</p>
    <div class="at-practice-grid">
        {{#cards}}
            <div class="at-card at-elev-sm at-practice-card">
                <i class="ph {{icon}}" aria-hidden="true"></i>
                <h4>{{title}}</h4>
                <p class="at-card-body">{{text}}</p>
                <a class="btn {{#primary}}btn-primary{{/primary}}{{^primary}}btn-secondary{{/primary}}" href="{{url}}">{{cta}} &rarr;</a>
            </div>
        {{/cards}}
    </div>
</div>
