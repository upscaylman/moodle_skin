{{!
    @template local_alphatrade/practice_list

    Case studies or challenges, in the "Module" list style of the maquette.

    Example context (json):
    {
        "backurl": "#", "title": "Challenges", "lead": "Testez votre niveau", "hasrows": true,
        "rows": [{"number": "01", "name": "50 setups", "url": "#", "islocked": false, "iscurrent": false, "iconclass": "ph ph-circle", "statusclass": "at-status-todo"}]
    }
}}
<div class="at-screen at-module">
    <a href="{{backurl}}" class="at-back">&larr; {{#str}}practicelab, local_alphatrade{{/str}}</a>
    <h2 class="at-module-title">{{title}}</h2>
    <p class="at-module-desc">{{lead}}</p>
    {{#hasrows}}
        <div class="at-card at-elev-sm at-lesson-list">
            {{#rows}}
                {{#islocked}}<div class="at-lesson-row is-locked"><i class="{{iconclass}} {{statusclass}}" aria-hidden="true"></i>{{number}} - {{name}}</div>{{/islocked}}
                {{^islocked}}<a class="at-lesson-row" href="{{url}}"><i class="{{iconclass}} {{statusclass}}" aria-hidden="true"></i>{{number}} - {{name}}</a>{{/islocked}}
            {{/rows}}
        </div>
    {{/hasrows}}
    {{^hasrows}}<p class="at-muted">{{#str}}nopracticeitems, local_alphatrade{{/str}}</p>{{/hasrows}}
</div>
