{{!
    @template local_alphatrade/profile

    Maquette Portail Etudiant, screen "Profil".

    Example context (json):
    {
        "fullname": "Julien Bouvier", "hasprogramme": true, "percent": 72,
        "figures": [{"label": "Modules", "value": "7 / 12"}],
        "hasbadges": true, "badges": [{"name": "Fondamentaux", "iconclass": "ph-fill ph-check-circle", "statusclass": "at-status-done", "islocked": false, "statuslabel": "Obtenu"}],
        "certificateurl": "#", "projecturl": "#",
        "links": [{"icon": "ph-user-circle", "label": "Modifier le profil", "url": "#"}]
    }
}}
<div class="at-screen at-profile">
    <h2 class="at-mb-2">{{fullname}}</h2>
    {{#hasprogramme}}
        <div class="at-profile-formation">{{#str}}formation, local_alphatrade{{/str}} - {{percent}} %</div>
        <div class="at-progress at-mb-24 at-max-400"><span style="width: {{percent}}%"></span></div>
    {{/hasprogramme}}
    <div class="at-profile-stats">
        {{#figures}}
            <div class="at-card at-elev-sm at-stat-mini is-profile"><div>{{value}}</div><span>{{label}}</span></div>
        {{/figures}}
    </div>
    {{#hasbadges}}
        <h5 class="at-h5-icon"><i class="ph ph-medal" aria-hidden="true"></i>{{#str}}badges, local_alphatrade{{/str}}</h5>
        <div class="at-checklist at-mb-22">
            {{#badges}}
                <div class="{{#islocked}}is-locked{{/islocked}}"><i class="{{iconclass}} {{statusclass}}" aria-hidden="true"></i>{{name}}<span class="sr-only"> ({{statuslabel}})</span></div>
            {{/badges}}
        </div>
    {{/hasbadges}}
    <div class="at-row-gap-10 at-wrap">
        <a class="btn btn-secondary" href="{{certificateurl}}">{{#str}}viewcertification, local_alphatrade{{/str}}</a>
        <a class="btn btn-ghost" href="{{projecturl}}">{{#str}}finalproject, local_alphatrade{{/str}}</a>
    </div>
    <hr class="at-hr">
    <div class="at-profile-links">
        {{#links}}<a href="{{url}}"><i class="ph {{icon}}" aria-hidden="true"></i>{{label}}</a>{{/links}}
    </div>
</div>
