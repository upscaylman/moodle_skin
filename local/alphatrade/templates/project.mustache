{{!
    @template local_alphatrade/project

    Maquette Portail Etudiant, screen "Projet final".

    Example context (json):
    {
        "hasproject": true, "percent": 85, "hassteps": true, "islocked": false, "availableinfo": "", "continueurl": "#",
        "steps": [{"number": "01", "name": "Marché", "url": "#", "iconclass": "ph-fill ph-check-circle", "statusclass": "at-status-done", "islocked": false, "statuslabel": "Terminé"}],
        "result": {"url": "#", "stats": {"trades": 247, "winrate": "48.2 %", "expectancy": "+0.38R"} },
        "backtestingurl": "#"
    }
}}
<div class="at-screen at-project">
    <div class="at-eyebrow at-inline-icon"><i class="ph ph-trophy" aria-hidden="true"></i>{{#str}}finalproject_upper, local_alphatrade{{/str}}</div>
    <h2 class="at-module-title">Alpha Trading System</h2>
    <p class="at-module-desc">{{#str}}project_lead, local_alphatrade{{/str}}</p>
    {{^hasproject}}<p class="at-muted">{{#str}}noproject, local_alphatrade{{/str}}</p>{{/hasproject}}
    {{#hasproject}}
        {{#islocked}}<p class="at-module-locked"><i class="ph ph-lock-simple" aria-hidden="true"></i> {{#str}}modulelocked, local_alphatrade{{/str}}{{#availableinfo}} - {{{availableinfo}}}{{/availableinfo}}</p>{{/islocked}}
        <div class="at-progress at-mb-20"><span style="width: {{percent}}%"></span></div>
        {{#hassteps}}
            <div class="at-checklist at-mb-22">
                {{#steps}}
                    {{#islocked}}<div class="is-locked"><i class="{{iconclass}} {{statusclass}}" aria-hidden="true"></i>{{number}} {{name}}</div>{{/islocked}}
                    {{^islocked}}<a href="{{url}}"><i class="{{iconclass}} {{statusclass}}" aria-hidden="true"></i>{{number}} {{name}}<span class="sr-only"> ({{statuslabel}})</span></a>{{/islocked}}
                {{/steps}}
            </div>
        {{/hassteps}}
    {{/hasproject}}
    <div class="at-card at-elev-sm at-pad-20 at-mb-22 at-max-480">
        <span class="at-card-kicker">{{#str}}yourresults, local_alphatrade{{/str}}</span>
        {{#result}}
            <p class="at-card-body at-mt-6">{{stats.trades}} {{#str}}trades_lower, local_alphatrade{{/str}} · {{stats.winrate}} win rate · {{stats.expectancy}} expectancy</p>
            <a class="btn btn-secondary" href="{{url}}">{{#str}}viewreport, local_alphatrade{{/str}} &rarr;</a>
        {{/result}}
        {{^result}}
            <p class="at-card-body at-mt-6">{{#str}}noresultsyet, local_alphatrade{{/str}}</p>
            <a class="btn btn-secondary" href="{{backtestingurl}}">{{#str}}backtesting, local_alphatrade{{/str}} &rarr;</a>
        {{/result}}
    </div>
    {{#continueurl}}<a class="btn btn-primary" href="{{continueurl}}">{{#str}}continueproject, local_alphatrade{{/str}} &rarr;</a>{{/continueurl}}
</div>
