{{!
    @template local_alphatrade/resources

    Maquette Portail Etudiant, screen "Ressources".

    Example context (json):
    {
        "action": "#", "type": "", "q": "",
        "pills": [{"label": "Tous", "url": "#", "active": true}],
        "hasitems": true, "configured": true,
        "items": [{"name": "Checklist avant entrée", "meta": "Document · 2 pages", "url": "#", "icon": "ph-file-text", "isdownload": true, "isuse": false}]
    }
}}
<div class="at-screen at-resources">
    <h2 class="at-mb-16">{{#str}}resources, local_alphatrade{{/str}}</h2>
    <form class="at-search at-search-400 at-mb-14" method="get" action="{{action}}" role="search">
        {{#type}}<input type="hidden" name="type" value="{{type}}">{{/type}}
        <label class="sr-only" for="at-resources-q">{{#str}}search{{/str}}</label>
        <input class="at-input" id="at-resources-q" type="text" name="q" value="{{q}}" placeholder="{{#str}}searchresources, local_alphatrade{{/str}}">
    </form>
    <div class="at-tags at-mb-18">
        {{#pills}}<a class="at-tag {{#active}}at-tag-accent{{/active}}{{^active}}at-tag-neutral{{/active}}" href="{{url}}"{{#active}} aria-current="true"{{/active}}>{{label}}</a>{{/pills}}
    </div>
    {{#hasitems}}
        <div class="at-stack-12">
            {{#items}}
                <div class="at-card at-elev-sm at-list-card at-pad-18">
                    <div class="at-list-card-main">
                        <i class="ph {{icon}}" aria-hidden="true"></i>
                        <div>
                            <h4 class="at-list-card-title">{{name}}</h4>
                            <div class="at-card-meta">{{meta}}</div>
                        </div>
                    </div>
                    <a class="btn btn-secondary" href="{{url}}">{{#isdownload}}{{#str}}download, local_alphatrade{{/str}} &darr;{{/isdownload}}{{^isdownload}}{{#isuse}}{{#str}}use, local_alphatrade{{/str}}{{/isuse}}{{^isuse}}{{#str}}open, local_alphatrade{{/str}}{{/isuse}} &rarr;{{/isdownload}}</a>
                </div>
            {{/items}}
        </div>
    {{/hasitems}}
    {{^hasitems}}
        <p class="at-muted">{{#configured}}{{#str}}noresources, local_alphatrade{{/str}}{{/configured}}{{^configured}}{{#str}}resourcesnotconfigured, local_alphatrade{{/str}}{{/configured}}</p>
    {{/hasitems}}
</div>
