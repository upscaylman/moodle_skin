{{!
    @template local_alphatrade/review

    Trainer correction of a chart analysis (patterns of the "Analyse de graphique" screen).

    Example context (json):
    {
        "backurl": "#", "student": "Claire Moreau", "number": "#012", "title": "Range asiatique", "symbol": "EUR/USD", "timeframe": "H1",
        "chartsrc": "https://www.tradingview.com/widgetembed/?symbol=FX%3AEURUSD&interval=60",
        "answers": {"structure": "HH/HL", "liquidity": "Equal highs", "bias": "Bullish", "scenario": "Sweep puis BOS", "submitted": "12/09/26"},
        "form": "<form></form>"
    }
}}
<div class="at-screen at-analyse">
    <a href="{{backurl}}" class="at-back">&larr; {{#str}}reviews, local_alphatrade{{/str}}</a>
    <div class="at-eyebrow">ANALYSE {{number}} · {{student}}</div>
    <h3 class="at-analyse-market">{{symbol}} · {{timeframe}}</h3>
    <div class="at-chartbox">
        <iframe src="{{chartsrc}}" title="{{symbol}} {{timeframe}} - TradingView" loading="lazy" referrerpolicy="no-referrer"></iframe>
    </div>
    <div class="at-staff-grid is-even">
        <div class="at-card at-elev-sm at-pad-22">
            <span class="at-card-kicker">{{#str}}studentanalysis, local_alphatrade{{/str}}</span>
            <h4 class="at-card-title at-mt-2">{{title}}</h4>
            {{#answers}}
                <div class="at-answers">
                    <div><span>{{#str}}analysis_structure, local_alphatrade{{/str}}</span>{{{structure}}}</div>
                    <div><span>{{#str}}analysis_liquidity, local_alphatrade{{/str}}</span>{{{liquidity}}}</div>
                    <div><span>{{#str}}analysis_bias, local_alphatrade{{/str}}</span>{{bias}}</div>
                    <div><span>{{#str}}analysis_scenario, local_alphatrade{{/str}}</span>{{{scenario}}}</div>
                </div>
                <div class="at-card-meta">{{#str}}submittedon, local_alphatrade, {{submitted}}{{/str}}</div>
            {{/answers}}
        </div>
        <div class="at-card at-elev-sm at-pad-22 at-formcard">
            <span class="at-card-kicker">{{#str}}correctiontitle, local_alphatrade{{/str}}</span>
            {{{form}}}
        </div>
    </div>
</div>
