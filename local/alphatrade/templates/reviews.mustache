{{!
    @template local_alphatrade/reviews

    Maquette Espace Enseignant, screen "Devoirs à corriger".

    Example context (json):
    {
        "filters": [{"label": "À corriger", "url": "#", "active": true}],
        "hasrows": true,
        "rows": [{"student": "Claire Moreau", "item": "Analyse de structure", "course": "Structure de marché - S8", "submitted": "Il y a 2h", "isreviewed": false, "score": "", "url": "#"}]
    }
}}
<div class="at-screen at-staff">
    <div class="at-tags at-mb-14">
        {{#filters}}<a class="at-tag {{#active}}at-tag-accent{{/active}}{{^active}}at-tag-neutral{{/active}}" href="{{url}}"{{#active}} aria-current="true"{{/active}}>{{label}}</a>{{/filters}}
    </div>
    <div class="at-card at-elev-sm at-table-card">
        <table class="at-table">
            <thead><tr><th>{{#str}}student, local_alphatrade{{/str}}</th><th>{{#str}}assignment, local_alphatrade{{/str}}</th><th>{{#str}}course{{/str}}</th><th>{{#str}}submitted, local_alphatrade{{/str}}</th><th>{{#str}}status, local_alphatrade{{/str}}</th><th><span class="sr-only">{{#str}}actions{{/str}}</span></th></tr></thead>
            <tbody>
                {{#rows}}
                    <tr>
                        <td>{{student}}</td>
                        <td>{{item}}</td>
                        <td>{{course}}</td>
                        <td>{{submitted}}</td>
                        <td>
                            {{#isreviewed}}<span class="at-tag at-tag-success"><i class="ph-fill ph-check-circle" aria-hidden="true"></i>{{#str}}filter_reviewed, local_alphatrade{{/str}}{{#score}} · {{score}}{{/score}}</span>{{/isreviewed}}
                            {{^isreviewed}}<span class="at-tag at-tag-warning"><i class="ph ph-clock" aria-hidden="true"></i>{{#str}}filter_submitted, local_alphatrade{{/str}}</span>{{/isreviewed}}
                        </td>
                        <td><a class="btn btn-ghost" href="{{url}}">{{#isreviewed}}{{#str}}view{{/str}}{{/isreviewed}}{{^isreviewed}}{{#str}}correct, local_alphatrade{{/str}}{{/isreviewed}}</a></td>
                    </tr>
                {{/rows}}
                {{^hasrows}}<tr><td colspan="6" class="at-muted">{{#str}}noreviews, local_alphatrade{{/str}}</td></tr>{{/hasrows}}
            </tbody>
        </table>
    </div>
</div>
