{{!
    @template local_alphatrade/strategy

    Maquette Portail Etudiant, screen "Stratégie".

    Example context (json):
    {
        "backurl": "#", "name": "Alpha Setup #01", "meta": "EUR/USD · H1",
        "stats": {"trades": 247, "winrate": "48.2 %", "expectancy": "+0.38R", "maxdrawdown": "-7.4R", "profitfactor": "1.74", "avgwin": "+1.91R", "avgloss": "-1.00R", "maxconsecutivelosses": 5, "verdict": "Votre stratégie présente une expectancy positive sur l'échantillon testé."},
        "iscurve": true, "curveurl": "#", "candlesurl": "#", "polyline": "0,140 480,0",
        "candles": {"hascandles": false}, "userealdata": false, "candleerror": "", "chartsrc": "https://www.tradingview.com/widgetembed/?symbol=FX%3AEURUSD&interval=60",
        "canedit": true, "hasrows": true,
        "rows": [{"date": "12/09/2026", "direction": "Long", "result": "+2.00R", "resultclass": "at-positive", "hasverify": false, "verifyicon": "", "verifyclass": "", "verifylabel": "", "deleteurl": "#"}],
        "adding": false, "addurl": "#", "saveurl": "#", "today": "2026-09-13", "sesskey": "x",
        "canverify": false, "verifyurl": "#", "editurl": "#", "deleteurl": "#"
    }
}}
<div class="at-screen at-strategy">
    <a href="{{backurl}}" class="at-back">&larr; {{#str}}backtesting, local_alphatrade{{/str}}</a>
    <h3 class="at-strat-name">{{name}}</h3>
    <div class="at-strat-meta">{{meta}}</div>

    {{#stats}}
        <div class="at-strat-stats">
            <div class="at-card at-elev-sm at-stat-mini"><div>{{trades}}</div><span>{{#str}}trades_upper, local_alphatrade{{/str}}</span></div>
            <div class="at-card at-elev-sm at-stat-mini"><div>{{winrate}}</div><span>WIN RATE</span></div>
            <div class="at-card at-elev-sm at-stat-mini"><div>{{expectancy}}</div><span>EXPECTANCY</span></div>
            <div class="at-card at-elev-sm at-stat-mini"><div>{{maxdrawdown}}</div><span>DRAWDOWN</span></div>
        </div>
    {{/stats}}

    <div class="at-row-between at-mb-10 at-wrap">
        <h5 class="at-m-0">{{#str}}evolution_upper, local_alphatrade{{/str}}</h5>
        <span class="at-seg">
            <a class="at-seg-opt{{#iscurve}} is-active{{/iscurve}}" href="{{curveurl}}">{{#str}}curve, local_alphatrade{{/str}}</a>
            <a class="at-seg-opt{{^iscurve}} is-active{{/iscurve}}" href="{{candlesurl}}">{{#str}}candles_real, local_alphatrade{{/str}}</a>
        </span>
    </div>
    {{#iscurve}}
        <div class="at-card at-elev-sm at-equity">
            <svg width="100%" height="140" viewBox="0 0 480 140" preserveAspectRatio="none" role="img" aria-label="{{#str}}equitycurve, local_alphatrade{{/str}}"><polyline points="{{polyline}}" fill="none" stroke="currentColor" stroke-width="2" vector-effect="non-scaling-stroke"></polyline></svg>
        </div>
    {{/iscurve}}
    {{^iscurve}}
        {{#userealdata}}
            {{#candles}}
                <div class="at-card at-elev-sm at-candles">
                    <svg viewBox="0 0 {{width}} {{height}}" width="100%" role="img" aria-label="{{#str}}candles_real, local_alphatrade{{/str}}">
                        {{#labels}}<line class="at-candles-grid" x1="0" x2="{{x2}}" y1="{{y}}" y2="{{y}}"></line><text class="at-candles-label" x="{{x}}" y="{{y}}" dominant-baseline="middle">{{label}}</text>{{/labels}}
                        {{#bars}}<g class="{{#up}}is-up{{/up}}{{^up}}is-down{{/up}}"><line x1="{{x}}" x2="{{x}}" y1="{{wy1}}" y2="{{wy2}}"></line><rect x="{{bx}}" y="{{by}}" width="{{bw}}" height="{{bh}}"></rect></g>{{/bars}}
                    </svg>
                    <div class="at-card-meta">{{from}} - {{to}} · {{#str}}lastprice, local_alphatrade{{/str}} {{last}} · London Strategic Edge</div>
                </div>
            {{/candles}}
        {{/userealdata}}
        {{^userealdata}}
            {{#candleerror}}<p class="at-muted at-small">{{candleerror}}</p>{{/candleerror}}
            <div class="at-chartbox at-chartbox-340">
                <iframe src="{{chartsrc}}" title="{{#str}}candles_real, local_alphatrade{{/str}} - TradingView" loading="lazy" referrerpolicy="no-referrer"></iframe>
            </div>
        {{/userealdata}}
    {{/iscurve}}

    {{#stats}}
        <h5 class="at-mb-10">{{#str}}statistics_upper, local_alphatrade{{/str}}</h5>
        <div class="at-strat-kv">
            <div><span>Profit Factor</span><span>{{profitfactor}}</span></div>
            <div><span>Average Win</span><span>{{avgwin}}</span></div>
            <div><span>Average Loss</span><span>{{avgloss}}</span></div>
            <div><span>Max consecutive losses</span><span>{{maxconsecutivelosses}}</span></div>
        </div>
        <p class="at-strat-verdict">{{verdict}}</p>
    {{/stats}}

    {{#canedit}}
        <div class="at-row-between at-mb-10 at-wrap" id="trades">
            <h5 class="at-m-0">{{#str}}trades_upper, local_alphatrade{{/str}}</h5>
            {{#canverify}}
                <form method="post" action="{{verifyurl}}" class="at-inline-form">
                    <input type="hidden" name="sesskey" value="{{sesskey}}">
                    <button type="submit" class="btn btn-ghost">{{#str}}verifymarket, local_alphatrade{{/str}}</button>
                </form>
            {{/canverify}}
        </div>
        {{#hasrows}}
            <div class="at-card at-elev-sm at-table-card at-mb-16">
                <table class="at-table">
                    <thead><tr><th>{{#str}}date, local_alphatrade{{/str}}</th><th>{{#str}}direction, local_alphatrade{{/str}}</th><th>{{#str}}result, local_alphatrade{{/str}}</th><th><span class="sr-only">{{#str}}actions{{/str}}</span></th></tr></thead>
                    <tbody>
                        {{#rows}}
                            <tr>
                                <td>{{date}}</td>
                                <td>{{direction}}</td>
                                <td class="{{resultclass}}">{{result}}{{#hasverify}} <i class="{{verifyicon}} {{verifyclass}}" title="{{verifylabel}}" aria-label="{{verifylabel}}"></i>{{/hasverify}}</td>
                                <td class="at-td-right"><a class="btn btn-ghost at-btn-tiny" href="{{deleteurl}}" aria-label="{{#str}}delete{{/str}}"><i class="ph ph-trash" aria-hidden="true"></i></a></td>
                            </tr>
                        {{/rows}}
                    </tbody>
                </table>
            </div>
        {{/hasrows}}
        {{#adding}}
            <form class="at-card at-elev-sm at-pad-18 at-mb-16 at-max-420" method="post" action="{{saveurl}}" id="addtrade">
                <input type="hidden" name="sesskey" value="{{sesskey}}">
                <div class="at-field at-mb-10"><label for="at-tr-date">{{#str}}date, local_alphatrade{{/str}}</label><input class="at-input" id="at-tr-date" type="date" name="tradedate" value="{{today}}"></div>
                <div class="at-field at-mb-10">
                    <span class="at-label">{{#str}}direction, local_alphatrade{{/str}}</span>
                    <div class="at-radio-row">
                        <label class="at-radio"><input type="radio" name="direction" value="long" checked><span class="at-dot"></span>Long</label>
                        <label class="at-radio"><input type="radio" name="direction" value="short"><span class="at-dot"></span>Short</label>
                    </div>
                </div>
                <div class="at-field at-mb-10"><label for="at-tr-r">{{#str}}resultr_long, local_alphatrade{{/str}}</label><input class="at-input" id="at-tr-r" type="text" inputmode="decimal" name="resultr" required placeholder="{{#str}}resultr_ph, local_alphatrade{{/str}}"></div>
                <div class="at-field-row at-mb-14">
                    <div class="at-field"><label for="at-tr-entry">Entry</label><input class="at-input" id="at-tr-entry" type="text" inputmode="decimal" name="entry"></div>
                    <div class="at-field"><label for="at-tr-sl">SL</label><input class="at-input" id="at-tr-sl" type="text" inputmode="decimal" name="stoploss"></div>
                    <div class="at-field"><label for="at-tr-tp">TP</label><input class="at-input" id="at-tr-tp" type="text" inputmode="decimal" name="takeprofit"></div>
                </div>
                <button type="submit" class="btn btn-primary">{{#str}}savetrade_long, local_alphatrade{{/str}}</button>
            </form>
        {{/adding}}
        <a class="btn btn-primary" href="{{addurl}}">{{#str}}addtrade, local_alphatrade{{/str}}</a>
        <div class="at-strat-owner-actions">
            <a class="btn btn-ghost" href="{{editurl}}">{{#str}}edit{{/str}}</a>
            <a class="btn btn-ghost" href="{{deleteurl}}">{{#str}}delete{{/str}}</a>
        </div>
    {{/canedit}}
    {{^canedit}}
        <div class="at-readonly-note">{{#str}}readonlystrategy, local_alphatrade{{/str}}</div>
    {{/canedit}}
</div>
