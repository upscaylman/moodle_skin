{{!
    @template local_alphatrade/teacher

    Maquette Espace Enseignant, screen "Tableau de bord".

    Example context (json):
    {
        "kpis": [{"label": "Étudiants actifs", "value": 84, "url": "#", "isaccent": false}],
        "queue": [{"student": "Claire Moreau", "item": "Analyse de structure", "course": "S8", "submitted": "Il y a 2h", "url": "#", "isreviewed": false}],
        "reviewsurl": "#",
        "hasactivity": true, "activity": [{"html": "<strong>Claire Moreau</strong> a terminé « Liquidité »", "time": "Il y a 2h", "isaccent": true}]
    }
}}
<div class="at-screen at-staff at-teacher">
    <div class="at-kpis">
        {{#kpis}}
            {{#url}}<a class="at-card at-elev-sm at-kpi" href="{{url}}">{{/url}}{{^url}}<div class="at-card at-elev-sm at-kpi">{{/url}}
                <span class="at-card-kicker">{{label}}</span>
                <div class="at-kpi-value{{#isaccent}} is-accent{{/isaccent}}">{{value}}</div>
            {{#url}}</a>{{/url}}{{^url}}</div>{{/url}}
        {{/kpis}}
    </div>
    <div class="at-staff-grid">
        <div class="at-card at-elev-sm at-panel">
            <div class="at-panel-head">
                <h4>{{#str}}toreviewfirst, local_alphatrade{{/str}}</h4>
                <a class="btn btn-ghost" href="{{reviewsurl}}">{{#str}}seeall, local_alphatrade{{/str}}</a>
            </div>
            <div class="at-table-scroll">
                <table class="at-table">
                    <thead><tr><th>{{#str}}student, local_alphatrade{{/str}}</th><th>{{#str}}assignment, local_alphatrade{{/str}}</th><th>{{#str}}submitted, local_alphatrade{{/str}}</th><th><span class="sr-only">{{#str}}actions{{/str}}</span></th></tr></thead>
                    <tbody>
                        {{#queue}}
                            <tr><td>{{student}}</td><td>{{item}}</td><td>{{submitted}}</td><td><a class="btn btn-ghost" href="{{url}}">{{#str}}correct, local_alphatrade{{/str}}</a></td></tr>
                        {{/queue}}
                        {{^queue}}<tr><td colspan="4" class="at-muted">{{#str}}noreviews, local_alphatrade{{/str}}</td></tr>{{/queue}}
                    </tbody>
                </table>
            </div>
        </div>
        <div class="at-card at-elev-sm at-pad-20">
            <h4 class="at-mb-12">{{#str}}recentactivity, local_alphatrade{{/str}}</h4>
            <div class="at-feed">
                {{#activity}}
                    <div><span class="at-feed-dot{{#isaccent}} is-accent{{/isaccent}}" aria-hidden="true"></span><div>{{{html}}}{{#time}} <span class="at-muted">· {{time}}</span>{{/time}}</div></div>
                {{/activity}}
                {{^hasactivity}}<div class="at-muted">{{#str}}noactivity, local_alphatrade{{/str}}</div>{{/hasactivity}}
            </div>
        </div>
    </div>
</div>
