{{!
    @template local_alphatrade/teacher_backtests

    Maquette Espace Enseignant, screen "Backtests des élèves".

    Example context (json):
    {
        "kpis": [{"label": "À revoir", "value": 3, "iswarning": true}],
        "hasrows": true,
        "rows": [{"student": "Claire Moreau", "name": "Alpha Setup #01", "market": "EUR/USD", "url": "#", "isreview": false, "reviewlabel": "À revoir",
            "stats": {"trades": 120, "winrate": "44.0 %", "expectancy": "+0.28R", "expectancyclass": "at-positive", "maxdrawdown": "-7.0R"} }]
    }
}}
<div class="at-screen at-staff">
    <div class="at-kpis">
        {{#kpis}}
            <div class="at-card at-elev-sm at-kpi">
                <span class="at-card-kicker">{{label}}</span>
                <div class="at-kpi-value{{#iswarning}} is-warning{{/iswarning}}">{{value}}</div>
            </div>
        {{/kpis}}
    </div>
    <div class="at-card at-elev-sm at-table-card">
        <table class="at-table">
            <thead><tr><th>{{#str}}student, local_alphatrade{{/str}}</th><th>{{#str}}strategy, local_alphatrade{{/str}}</th><th>{{#str}}market, local_alphatrade{{/str}}</th><th>{{#str}}trades, local_alphatrade{{/str}}</th><th>{{#str}}winrate, local_alphatrade{{/str}}</th><th>{{#str}}expectancy, local_alphatrade{{/str}}</th><th>{{#str}}drawdown, local_alphatrade{{/str}}</th><th>{{#str}}status, local_alphatrade{{/str}}</th><th><span class="sr-only">{{#str}}actions{{/str}}</span></th></tr></thead>
            <tbody>
                {{#rows}}
                    <tr>
                        <td>{{student}}</td>
                        <td>{{name}}</td>
                        <td>{{market}}</td>
                        <td>{{stats.trades}}</td>
                        <td>{{stats.winrate}}</td>
                        <td class="{{stats.expectancyclass}}">{{stats.expectancy}}</td>
                        <td>{{stats.maxdrawdown}}</td>
                        <td>
                            {{#isreview}}<span class="at-tag at-tag-warning"><i class="ph ph-warning" aria-hidden="true"></i>{{reviewlabel}}</span>{{/isreview}}
                            {{^isreview}}<span class="at-tag at-tag-success"><i class="ph-fill ph-check-circle" aria-hidden="true"></i>{{#str}}validated, local_alphatrade{{/str}}</span>{{/isreview}}
                        </td>
                        <td><a class="btn btn-ghost" href="{{url}}">{{#str}}open, local_alphatrade{{/str}}</a></td>
                    </tr>
                {{/rows}}
                {{^hasrows}}<tr><td colspan="9" class="at-muted">{{#str}}nostrategiesstudents, local_alphatrade{{/str}}</td></tr>{{/hasrows}}
            </tbody>
        </table>
    </div>
</div>
