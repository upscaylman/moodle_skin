{{!
    @template local_alphatrade/tools

    Tools: 2x2 grid of shortcut cards.

    Example context (json):
    {
        "cards": [{"icon": "ph-scales", "title": "Calculateur de risque", "text": "Montant risqué par trade", "url": "#"}]
    }
}}
<div class="alpha-tools">
    <header class="alpha-pagehead">
        <div>
            <p class="alpha-eyebrow">{{#str}}tools, local_alphatrade{{/str}}</p>
            <h1 class="alpha-title">{{#str}}tools_title, local_alphatrade{{/str}}</h1>
            <p class="alpha-lead">{{#str}}tools_lead, local_alphatrade{{/str}}</p>
        </div>
    </header>
    <div class="alpha-grid alpha-grid-2">
        {{#cards}}
            <a class="alpha-card alpha-card-link" href="{{url}}">
                <span class="alpha-card-icon"><i class="ph {{icon}}" aria-hidden="true"></i></span>
                <p class="alpha-card-caps">{{title}}</p>
                <p class="alpha-card-text">{{text}}</p>
                <span class="alpha-card-footer">
                    <span></span>
                    <span class="alpha-link-cta">{{#str}}open, local_alphatrade{{/str}} <i class="ph ph-arrow-right" aria-hidden="true"></i></span>
                </span>
            </a>
        {{/cards}}
    </div>
</div>
