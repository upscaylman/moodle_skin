{{!
    @template local_alphatrade/videos

    Pilier Vidéo : toutes les vidéos du programme, groupées par module.

    Example context (json):
    {
        "hasvideos": true, "count": 4, "parcoursurl": "#",
        "modules": [{"number": "01", "name": "Module 0", "url": "#", "videocount": 2,
            "videos": [{"name": "Présentation du programme", "url": "#", "islocked": false, "isdone": true, "modname": "url"}]}]
    }
}}
<div class="at-screen at-videos">
    {{#hasvideos}}
        <p class="at-muted at-small at-mb-18">{{#str}}videos_count, local_alphatrade, {{count}}{{/str}}</p>
        {{#modules}}
            <section class="at-mb-18">
                <div class="at-row-between at-mb-12">
                    <h3 class="at-eyebrow at-m-0">{{#str}}modulelabel, local_alphatrade, {{number}}{{/str}} · {{name}}</h3>
                    <a href="{{url}}" class="at-small">{{#str}}gotomodule, local_alphatrade{{/str}} &rarr;</a>
                </div>
                <div class="at-videogrid">
                    {{#videos}}
                        {{#islocked}}
                            <div class="at-card at-elev-sm at-video at-video-locked" aria-disabled="true">
                                <span class="at-video-thumb"><i class="ph ph-lock-simple" aria-hidden="true"></i></span>
                                <span class="at-video-name">{{name}}</span>
                                <span class="at-video-meta">{{#str}}locked, local_alphatrade{{/str}}</span>
                            </div>
                        {{/islocked}}
                        {{^islocked}}
                            <a class="at-card at-elev-sm at-video at-hoverable" href="{{url}}">
                                <span class="at-video-thumb"><i class="ph ph-play" aria-hidden="true"></i></span>
                                <span class="at-video-name">{{name}}</span>
                                <span class="at-video-meta">
                                    {{#isdone}}<i class="ph ph-check-circle" aria-hidden="true"></i>{{#str}}watched, local_alphatrade{{/str}}{{/isdone}}
                                    {{^isdone}}{{#str}}towatch, local_alphatrade{{/str}}{{/isdone}}
                                </span>
                            </a>
                        {{/islocked}}
                    {{/videos}}
                </div>
            </section>
        {{/modules}}
    {{/hasvideos}}
    {{^hasvideos}}
        <div class="at-card at-elev-sm at-pad-22 at-empty-card">
            <i class="ph ph-play-circle at-empty-icon" aria-hidden="true"></i>
            <h3 class="at-card-title">{{#str}}videos_empty, local_alphatrade{{/str}}</h3>
            <p class="at-card-body">{{#str}}videos_empty_desc, local_alphatrade{{/str}}</p>
            <a class="btn btn-secondary" href="{{parcoursurl}}">{{#str}}gotoparcours, local_alphatrade{{/str}}</a>
        </div>
    {{/hasvideos}}
</div>
