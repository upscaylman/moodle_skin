{{!
    @template block_timeline/no-courses

    Alpha Trade override: empty state with a Phosphor icon and centred text (maquette Timeline).

    Example context (json):
    {
        "hascourses": false,
        "urls": {
            "noevents": "#"
        }
    }
}}
{{^hascourses}}
    <div class="at-empty" data-region="no-courses-empty-message">
        <i class="ph ph-books" aria-hidden="true"></i>
        <p>{{#str}} nocoursesinprogress, block_timeline {{/str}}</p>
    </div>
{{/hascourses}}
