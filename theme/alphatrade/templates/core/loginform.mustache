{{!
    @template core/loginform

    Maquette Connexion: title, subtitle, e-mail, password, forgotten password, "Se connecter".
    Keeps every core feature (errors, maintenance, identity providers, sign-up, guest,
    recaptcha, cookies notice) but only shows them when the site enables them.

    Example context (json):
    {
        "autofocusform": false,
        "canloginasguest": false,
        "canloginbyemail": true,
        "cansignup": false,
        "showloginform": true,
        "error": "",
        "info": "",
        "forgotpasswordurl": "#",
        "hasidentityproviders": false,
        "hasinstructions": false,
        "identityproviders": [],
        "loginurl": "#",
        "signupurl": "#",
        "sitename": "Alpha Trade",
        "logintoken": "randomstring",
        "maintenance": "",
        "languagemenu": "",
        "togglepassword": true,
        "smallscreensonly": true
    }
}}
<div class="loginform at-loginform">
    <h3 class="login-heading at-login-title">{{#str}}login_title, theme_alphatrade{{/str}}</h3>
    <p class="at-login-sub">{{#str}}logintagline, theme_alphatrade{{/str}}</p>

    {{#maintenance}}
        <div class="alert alert-danger login-maintenance">
            {{{maintenance}}}
        </div>
    {{/maintenance}}
    {{#error}}
        <div class="alert alert-danger" id="loginerrormessage" role="alert">
            <i class="ph ph-warning-circle" aria-hidden="true"></i> {{error}}
        </div>
    {{/error}}
    {{#info}}
        <div class="alert alert-info" id="logininfomessage" role="status">{{info}}</div>
    {{/info}}

    {{#showloginform}}
        <form class="login-form" action="{{loginurl}}" method="post" id="login">
            <input id="anchor" type="hidden" name="anchor" value="">
            <script>document.getElementById('anchor').value = location.hash;</script>
            <input type="hidden" name="logintoken" value="{{logintoken}}">
            <div class="login-form-username at-field at-mb-14">
                <label for="username">
                    {{#canloginbyemail}}{{#str}}loginemail, theme_alphatrade{{/str}}{{/canloginbyemail}}
                    {{^canloginbyemail}}{{#str}}loginusername, theme_alphatrade{{/str}}{{/canloginbyemail}}
                </label>
                <input type="text" name="username" id="username" {{!
                    !}}class="at-input" {{!
                    !}}value="{{username}}" {{!
                    !}}placeholder="{{#canloginbyemail}}{{#cleanstr}}loginemailplaceholder, theme_alphatrade{{/cleanstr}}{{/canloginbyemail}}{{!
                    !}}{{^canloginbyemail}}{{#cleanstr}}username{{/cleanstr}}{{/canloginbyemail}}" {{!
                    !}}autocomplete="username">
            </div>
            <div class="login-form-password at-field at-mb-8">
                <label for="password">{{#str}}password{{/str}}</label>
                <input type="password" name="password" id="password" value="" {{!
                    !}}class="at-input" {{!
                    !}}placeholder="&bull;&bull;&bull;&bull;&bull;&bull;&bull;&bull;" {{!
                    !}}autocomplete="current-password">
            </div>
            {{#recaptcha}}
                <div class="login-form-recaptcha at-mb-14">
                    {{{recaptcha}}}
                </div>
            {{/recaptcha}}
            <div class="login-form-forgotpassword at-login-forgot">
                <a href="{{forgotpasswordurl}}">{{#str}}forgotpassword, theme_alphatrade{{/str}}</a>
            </div>
            <div class="login-form-submit">
                <button class="btn btn-primary btn-block" type="submit" id="loginbtn">{{#str}}loginsubmit, theme_alphatrade{{/str}}</button>
            </div>
        </form>
    {{/showloginform}}

    {{#hasidentityproviders}}
        <div class="at-login-divider"><span>{{#str}}or, theme_alphatrade{{/str}}</span></div>
        <div class="login-identityproviders">
            {{#identityproviders}}
                <a class="btn btn-secondary btn-block login-identityprovider-btn" href="{{url}}">
                    {{#iconurl}}
                        <img src="{{iconurl}}" alt="" width="20" height="20"/>
                    {{/iconurl}}
                    {{name}}
                </a>
            {{/identityproviders}}
        </div>
    {{/hasidentityproviders}}

    {{#hasinstructions}}
        <div class="at-login-divider"></div>
        <div class="login-instructions">
            {{{instructions}}}
        </div>
    {{/hasinstructions}}
    {{#cansignup}}
        <div class="login-signup">
            <a class="btn btn-secondary btn-block" href="{{signupurl}}">{{#str}}startsignup{{/str}}</a>
        </div>
    {{/cansignup}}

    {{#canloginasguest}}
        <div class="at-login-divider"></div>
        <form action="{{loginurl}}" method="post" id="guestlogin">
            <input type="hidden" name="logintoken" value="{{logintoken}}">
            <input type="hidden" name="username" value="guest" />
            <input type="hidden" name="password" value="guest" />
            <button class="btn btn-secondary btn-block" type="submit" id="loginguestbtn">{{#str}}loginguest{{/str}}</button>
        </form>
    {{/canloginasguest}}

    {{#languagemenu}}
        <div class="at-login-meta">
            <div class="login-languagemenu">
                {{>core/action_menu}}
            </div>
        </div>
    {{/languagemenu}}
</div>

{{#js}}
    {{^error}}
        {{#autofocusform}}
            require(['core_form/events'], function(FormEvent) {
                function autoFocus() {
                    const userNameField = document.getElementById('username');
                    const passwordField = document.getElementById('password');
                    if (userNameField && userNameField.value.length == 0) {
                        userNameField.focus();
                    } else if (passwordField) {
                        passwordField.focus();
                    }
                }
                autoFocus();
                window.addEventListener(FormEvent.eventTypes.fieldStructureChanged, autoFocus);
            });
        {{/autofocusform}}
    {{/error}}
    require(['core/pending'], function(Pending) {
        const errorMessageDiv = document.getElementById('loginerrormessage');
        const infoMessageDiv = document.getElementById('logininfomessage');
        const errorMessage = errorMessageDiv?.textContent.trim();
        const infoMessage = infoMessageDiv?.textContent.trim();
        if (errorMessage || infoMessage) {
            const pendingJS = new Pending('login-move-focus');
            const usernameField = document.getElementById('username');
            setTimeout(function() {
                if (errorMessage && usernameField) {
                    usernameField.focus();
                }
                if (errorMessage) {
                    errorMessageDiv.innerHTML += "&nbsp;";
                }
                if (infoMessage) {
                    infoMessageDiv.innerHTML += "&nbsp;";
                }
                pendingJS.resolve();
            }, 500);
        }
    });
    {{#togglepassword}}
        require(['core/togglesensitive'], function(ToggleSensitive) {
            ToggleSensitive.init("password", {{smallscreensonly}});
        });
    {{/togglepassword}}
    require(['core_form/submit'], function(Submit) {
        Submit.init("loginbtn");
        {{#canloginasguest}}
            Submit.init("loginguestbtn");
        {{/canloginasguest}}
    });
{{/js}}
