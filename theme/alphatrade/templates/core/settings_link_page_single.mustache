{{!
    @template core/settings_link_page_single

    Alpha Trade override: a setting link of the admin tree as a plain list row (maquette Espace Admin, "Paramètres");
    deeper levels are indented sub-lists under a small label.

    Example context (json):
    {
        "text": "Root of menu",
        "key": "test0",
        "display": true,
        "action": "#",
        "children": []
    }
}}
{{#display}}
    {{#action}}
        <li><a class="at-settings-link" href="{{{action}}}">{{text}}</a></li>
    {{/action}}
    {{^action}}
        <li class="at-settings-sublabel">{{text}}</li>
    {{/action}}
    {{#children.count}}
        <li>
            <ul class="at-settings-links is-nested">
                {{#children}}
                    {{> core/settings_link_page_single }}
                {{/children}}
            </ul>
        </li>
    {{/children.count}}
{{/display}}
