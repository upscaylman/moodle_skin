{{!
    @template core_calendar/calendar_month

    Alpha Trade override. In the Calendar block (dashboard /my/, maquette Espace Admin "Calendrier") the month is
    theme_alphatrade/calendar_month_block: that template name is also the data-template the calendar JS re-renders
    when changing month. The full calendar page keeps Moodle's header and detailed month.

    Example context (json):
    {
        "iscalendarblock": false
    }
}}
<div id="calendar-month-{{uniqid}}-{{calendarinstanceid}}" data-template="{{#iscalendarblock}}theme_alphatrade/calendar_month_block{{/iscalendarblock}}{{^iscalendarblock}}core_calendar/month_detailed{{/iscalendarblock}}"{{#iscalendarblock}} class="at-calblock"{{/iscalendarblock}}>
    {{#iscalendarblock}}
        <div aria-live="polite" class="sr-only calendar-announcements"></div>
        {{> theme_alphatrade/calendar_month_block}}
    {{/iscalendarblock}}
    {{^iscalendarblock}}
        {{> core_calendar/header}}
        {{> core_calendar/month_detailed}}
    {{/iscalendarblock}}
</div>
{{#js}}
require(['jquery', 'core_calendar/calendar', 'core_calendar/popover'], function($, Calendar, calendarPopover) {
    const isCalendarBlock = {{#iscalendarblock}}true{{/iscalendarblock}}{{^iscalendarblock}}false{{/iscalendarblock}};
    Calendar.init($("#calendar-month-{{uniqid}}-{{calendarinstanceid}}"), isCalendarBlock);
});
{{/js}}
