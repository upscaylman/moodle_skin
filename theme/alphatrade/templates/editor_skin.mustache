{{!
    @template theme_alphatrade/editor_skin

    Dark TinyMCE interface on every page. editor_tiny sets the light "oxide" skin in its configuration; this switches
    each editor to TinyMCE's own "oxide-dark" skin (colours tuned in scss/post/_editor.scss) as TinyMCE registers its
    global object, before any editor renders, whenever the editor is created (forms, modals, AJAX). A plain inline
    script rather than a js block: it must run before editor_tiny loads TinyMCE.

    Example context (json):
    {}
}}
<script>
(function() {
    var darken = function(manager) {
        if (!manager || manager.alphatradeDarkSkin || typeof manager.init !== 'function') {
            return;
        }
        manager.alphatradeDarkSkin = true;
        var init = manager.init;
        manager.init = function(config) {
            if (config && (!config.skin || config.skin === 'oxide')) {
                config.skin = 'oxide-dark';
            }
            return init.apply(this, arguments);
        };
    };
    if (window.tinymce) {
        darken(window.tinymce);
        return;
    }
    var manager;
    Object.defineProperty(window, 'tinymce', {
        configurable: true,
        enumerable: true,
        get: function() {
            return manager;
        },
        set: function(value) {
            manager = value;
            darken(value);
        }
    });
})();
</script>
