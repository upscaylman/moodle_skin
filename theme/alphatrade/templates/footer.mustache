{{!
    @template theme_alphatrade/footer

    Minimal footer: no "Powered by Moodle", but keeps the hooks Moodle needs
    (standard_footer_html, standard_end_of_body_html, debug output).

    Example context (json):
    {
        "sitename": "Alpha Trade",
        "output": {"standard_footer_html": "", "standard_end_of_body_html": "", "debug_footer_html": ""}
    }
}}
<footer id="page-footer" class="alpha-footer d-print-none">
    <div class="alpha-footer-inner">
        <span class="alpha-footer-brand">{{#str}}footerbrand, theme_alphatrade{{/str}}</span>
        <span class="alpha-footer-disclaimer">{{#str}}nosignals, theme_alphatrade{{/str}}</span>
        <div class="alpha-footer-links">
            {{# output.supportemail }}<span>{{{ output.supportemail }}}</span>{{/ output.supportemail }}
        </div>
    </div>
    <div class="alpha-footer-standard">
        <div class="tool_usertours-resettourcontainer"></div>
        {{{ output.standard_footer_html }}}
        {{{ output.standard_end_of_body_html }}}
    </div>
    <div class="footer-content-debugging footer-dark bg-dark text-light">
        <div class="container-fluid footer-dark-inner">
            {{{ output.debug_footer_html }}}
        </div>
    </div>
</footer>
