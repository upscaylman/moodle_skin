{{!
    @template theme_alphatrade/header

    In-page header (maquette "at-desktop-header"): title + subtitle on the left,
    search, notifications and avatar on the right. On mobile the actions move into the top bar.

    Example context (json):
    {
        "isalphapage": true, "isnativepage": false,
        "title": "Accueil", "subtitle": "Votre parcours Alpha Trade.",
        "searchurl": "#", "nav": {"isstudent": true},
        "output": {"navbar_plugin_output": "", "edit_switch": "", "full_header": ""}
    }
}}
<div class="at-desktop-header d-print-none">
    <div class="at-page-title">
        {{#isalphapage}}
            <h1>{{title}}</h1>
            {{#subtitle}}<p>{{subtitle}}</p>{{/subtitle}}
            {{#headingbutton}}<div class="at-heading-button">{{{headingbutton}}}</div>{{/headingbutton}}
        {{/isalphapage}}
        {{#isnativepage}}
            {{{ output.full_header }}}
        {{/isnativepage}}
    </div>
    <div id="usernavigation" class="at-header-actions">
        {{#nav.isstudent}}
            <a class="btn btn-icon btn-secondary at-header-search" href="{{searchurl}}" aria-label="{{#str}}search{{/str}}">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><path d="M21 21l-4.3-4.3"></path></svg>
            </a>
        {{/nav.isstudent}}
        {{{ output.navbar_plugin_output }}}
        <div class="usermenu-container" data-region="usermenu">
            {{#usermenu}}
                {{> core/user_menu }}
            {{/usermenu}}
        </div>
        <div class="at-editswitch">{{{ output.edit_switch }}}</div>
    </div>
</div>
