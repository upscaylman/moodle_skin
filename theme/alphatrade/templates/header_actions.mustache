{{!
    @template theme_alphatrade/header_actions

    Header actions shared by every page (app shell and standalone pages), same order everywhere: search, notifications
    (bell + unread badge), avatar + first name, edit mode switch (when Moodle allows editing on the page).
    The notifications centre opens when the pointer rests on the bell (and still with a click or the keyboard).

    Example context (json):
    {
        "searchurl": "#",
        "output": {"navbar_plugin_output": "", "edit_switch": ""}
    }
}}
<div id="usernavigation" class="at-header-actions">
    <a class="btn btn-icon btn-secondary at-header-search" href="{{searchurl}}" aria-label="{{#str}}search{{/str}}" title="{{#str}}search{{/str}}">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><path d="M21 21l-4.3-4.3"></path></svg>
    </a>
    {{{ output.navbar_plugin_output }}}
    <div class="usermenu-container" data-region="usermenu">
        {{#usermenu}}
            {{> core/user_menu }}
        {{/usermenu}}
    </div>
    <div class="at-editswitch">{{{ output.edit_switch }}}</div>
</div>
{{#js}}
(function() {
    // Notifications centre on hover (pointer devices): open when the pointer enters the bell area, close shortly after it
    // leaves. A click while it is open from hovering keeps it open; Moodle's own click, keyboard and outside click behaviour stay.
    var region = document.querySelector('.at-header-actions .popover-region-notifications');
    if (!region || !window.matchMedia || !window.matchMedia('(hover: hover)').matches) {
        return;
    }
    var toggle = region.querySelector('[data-region="popover-region-toggle"]');
    var timer = null;
    var openedbyhover = false;
    var isopen = function() {
        return !region.classList.contains('collapsed');
    };
    region.addEventListener('mouseenter', function() {
        clearTimeout(timer);
        if (!isopen()) {
            openedbyhover = true;
            toggle.click();
        }
    });
    region.addEventListener('mouseleave', function() {
        clearTimeout(timer);
        timer = setTimeout(function() {
            if (openedbyhover && isopen() && !region.contains(document.activeElement)) {
                toggle.click();
            }
            openedbyhover = false;
        }, 350);
    });
    toggle.addEventListener('click', function(e) {
        if (e.isTrusted && openedbyhover && isopen()) {
            e.preventDefault();
            e.stopImmediatePropagation();
            openedbyhover = false;
        }
    }, true);
})();
{{/js}}
