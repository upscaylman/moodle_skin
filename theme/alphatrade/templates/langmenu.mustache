{{!
    @template theme_alphatrade/langmenu

    Sélecteur de langue du bandeau, présent sur toutes les pages : app, site public, connexion.
    Chaque entrée recharge la page courante avec le paramètre lang, comme le menu natif de Moodle.

    Example context (json):
    {
        "haslangs": true, "currentlang": "FR", "currentlangname": "Français",
        "langs": [{"code": "fr", "short": "FR", "name": "Français", "url": "#", "active": true}]
    }
}}
{{#haslangs}}
    <div class="at-langmenu dropdown">
        <button class="btn btn-icon btn-secondary at-langbtn" type="button" data-toggle="dropdown"
            aria-haspopup="true" aria-expanded="false" title="{{currentlangname}}" aria-label="{{#str}}language{{/str}}">
            <i class="ph ph-translate" aria-hidden="true"></i>
            <span class="at-langbtn-code">{{currentlang}}</span>
        </button>
        <div class="dropdown-menu dropdown-menu-right at-langlist">
            {{#langs}}
                <a class="dropdown-item at-langitem at-hoverable{{#active}} is-active{{/active}}" href="{{url}}"
                    lang="{{code}}"{{#active}} aria-current="true"{{/active}}>
                    <span class="at-langitem-code">{{short}}</span>
                    <span class="at-langitem-name">{{name}}</span>
                </a>
            {{/langs}}
        </div>
    </div>
{{/haslangs}}
