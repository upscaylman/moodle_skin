{{!
    @template theme_alphatrade/lesson_footer

    Maquette "Leçon": "Leçon terminée" (secondary) and "Leçon suivante" (primary).

    Example context (json):
    {
        "lesson": {
            "isquiz": false,
            "hasmanualcompletion": true,
            "completiontoggle": {"cmid": 1, "activityname": "Leçon", "overallcomplete": true, "overallincomplete": false, "istrackeduser": true},
            "hasautocompletion": false, "iscomplete": true,
            "hasnext": true, "nexturl": "#", "nextlabel": "Leçon suivante"
        }
    }
}}
{{^lesson.isquiz}}
<div class="at-lesson-actions d-print-none">
    <div>
        {{#lesson.hasmanualcompletion}}
            {{#lesson.completiontoggle}}
                {{> core_course/completion_manual }}
            {{/lesson.completiontoggle}}
        {{/lesson.hasmanualcompletion}}
        {{#lesson.hasautocompletion}}
            {{#lesson.iscomplete}}<span class="btn btn-secondary is-static"><i class="ph-fill ph-check-circle" aria-hidden="true"></i>{{#str}}lessondone, theme_alphatrade{{/str}}</span>{{/lesson.iscomplete}}
        {{/lesson.hasautocompletion}}
    </div>
    {{#lesson.hasnext}}
        <a href="{{lesson.nexturl}}" class="btn btn-primary">{{lesson.nextlabel}} &rarr;</a>
    {{/lesson.hasnext}}
</div>
{{/lesson.isquiz}}
