{{!
    @template theme_alphatrade/lesson_header

    Lesson reader / quiz header (wireframe v3, screens 4 and 5).

    Example context (json):
    {
        "lesson": {
            "isquiz": false,
            "moduleurl": "#",
            "modulename": "Fondamentaux des marchés",
            "modulenumber": "01",
            "index": "03",
            "count": "08",
            "title": "Offre, demande et liquidité",
            "counter": "Leçon 03 / 08",
            "modulelabel": "Module 01"
        }
    }
}}
<header class="alpha-lesson-header">
    <div class="alpha-lesson-topbar">
        <a href="{{lesson.moduleurl}}" class="alpha-backlink">
            <i class="ph ph-arrow-left" aria-hidden="true"></i>
            <span>{{lesson.modulename}}</span>
        </a>
        {{^lesson.isquiz}}
            <span class="alpha-lesson-counter">{{lesson.counter}}</span>
        {{/lesson.isquiz}}
    </div>
    {{#lesson.isquiz}}
        <p class="alpha-eyebrow">{{#str}}evaluation, theme_alphatrade{{/str}}</p>
        <h1 class="alpha-lesson-title">{{lesson.modulelabel}} - {{lesson.modulename}}</h1>
        <p class="alpha-lesson-subtitle">{{lesson.title}}</p>
    {{/lesson.isquiz}}
    {{^lesson.isquiz}}
        <h1 class="alpha-lesson-title">{{lesson.title}}</h1>
    {{/lesson.isquiz}}
</header>
