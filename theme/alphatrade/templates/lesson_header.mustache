{{!
    @template theme_alphatrade/lesson_header

    Maquette "Leçon": back link + counter. Maquette "Évaluation": module, question counter,
    progress, and the centered result card on the review page.

    Example context (json):
    {
        "lesson": {
            "isquiz": true, "moduleurl": "#", "modulename": "Structure de marché", "modulelabel": "Module 03", "counter": "Leçon 07 / 08",
            "hasquestion": true, "questioncounter": "Question 4 / 10", "questionpercent": 40,
            "hasresult": false, "result": {"score": "8 / 10", "percent": "80 %", "passed": true, "label": "ÉVALUATION VALIDÉE", "nexturl": "#", "nextlabel": "Continuer le parcours"}
        }
    }
}}
{{^lesson.isquiz}}
    <div class="at-lesson-top">
        <a href="{{lesson.moduleurl}}">&larr; {{lesson.modulename}}</a>
        <span>{{lesson.counter}}</span>
    </div>
{{/lesson.isquiz}}
{{#lesson.isquiz}}
    <div class="at-quiz-head">
        <div class="at-eyebrow">{{#str}}evaluation_upper, theme_alphatrade{{/str}}</div>
        <div class="at-quiz-module">{{lesson.modulelabel}} - {{lesson.modulename}}</div>
        {{#lesson.hasquestion}}
            <div class="at-quiz-count"><span>{{lesson.questioncounter}}</span><span>{{lesson.questionpercent}} %</span></div>
            <div class="at-progress at-progress-5"><span style="width: {{lesson.questionpercent}}%"></span></div>
        {{/lesson.hasquestion}}
    </div>
    {{#lesson.hasresult}}
        {{#lesson.result}}
            <div class="at-card at-elev-md at-quiz-result">
                <div class="at-quiz-score">{{score}}</div>
                <div class="at-quiz-percent">{{percent}}</div>
                {{#passed}}<div class="at-quiz-verdict is-passed"><i class="ph-fill ph-check-circle" aria-hidden="true"></i>{{label}}</div>{{/passed}}
                {{^passed}}<div class="at-quiz-verdict is-failed"><i class="ph ph-warning" aria-hidden="true"></i>{{label}}</div>{{/passed}}
                <a class="btn btn-primary" href="{{nexturl}}">{{nextlabel}} &rarr;</a>
            </div>
        {{/lesson.result}}
    {{/lesson.hasresult}}
{{/lesson.isquiz}}
