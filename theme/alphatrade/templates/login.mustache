{{!
    @template theme_alphatrade/login

    Login page shell. The form itself is core/loginform (overridden in this theme).

    Example context (json):
    {
        "sitename": "Alpha Trade",
        "output": {
            "doctype": "<!DOCTYPE html>",
            "page_title": "Connexion",
            "favicon": "favicon.ico",
            "main_content": "<h1>Form</h1>"
        },
        "bodyattributes": "",
        "logourl": "logo.png",
        "publicurl": "#"
    }
}}
{{> theme_boost/head }}

<body {{{ bodyattributes }}}>
{{> core/local/toast/wrapper}}

<div id="page-wrapper">
    {{{ output.standard_top_of_body_html }}}
    <div class="alpha-login-blob" aria-hidden="true"></div>
    <div id="page" class="alpha-login-page">
        <div id="page-content">
            <div id="region-main-box">
                <div id="region-main">
                    <div class="login-wrapper">
                        <div class="login-container alpha-login-card">
                            <img src="{{logourl}}" class="alpha-login-logo" alt="{{sitename}}">
                            {{{ output.main_content }}}
                        </div>
                        <p class="alpha-login-public">
                            {{#str}}notmember, theme_alphatrade{{/str}}
                            <a href="{{publicurl}}">{{#str}}discover, theme_alphatrade{{/str}}</a>
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <footer id="page-footer" class="alpha-login-footer">
        <span>{{#str}}footerbrand, theme_alphatrade{{/str}}</span>
        <div class="alpha-footer-standard">
            {{{ output.standard_footer_html }}}
            {{{ output.standard_end_of_body_html }}}
        </div>
        <div class="footer-content-debugging footer-dark bg-dark text-light">
            <div class="container-fluid footer-dark-inner">
                {{{ output.debug_footer_html }}}
            </div>
        </div>
    </footer>
</div>

</body>
</html>
{{#js}}
M.util.js_pending('theme_boost/loader');
require(['theme_boost/loader'], function() {
  M.util.js_complete('theme_boost/loader');
});
{{/js}}
