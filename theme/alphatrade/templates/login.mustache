{{!
    @template theme_alphatrade/login

    Login page shell. The form itself is core/loginform (overridden in this theme).

    Example context (json):
    {
        "sitename": "Alpha Trade",
        "output": {
            "doctype": "<!DOCTYPE html>",
            "page_title": "Connexion",
            "favicon": "favicon.ico",
            "main_content": "<h1>Form</h1>"
        },
        "bodyattributes": "",
        "logourl": "logo.png",
        "publicurl": "#", "contacturl": "#"
    }
}}
{{> theme_boost/head }}

<body {{{ bodyattributes }}}>
{{> core/local/toast/wrapper}}

<div id="page-wrapper" class="at-login">
    {{{ output.standard_top_of_body_html }}}
    <div id="page" class="at-login-page">
        <div class="at-login-column">
            <a href="{{publicurl}}" class="at-login-logo-link"><img src="{{logourl}}" class="at-login-logo" alt="{{sitename}}"></a>
            <div id="page-content" class="at-card at-elev-md at-login-card">
                <div id="region-main-box">
                    <div id="region-main">
                        {{{ output.main_content }}}
                    </div>
                </div>
            </div>
            <p class="at-login-contact">
                {{#str}}notmember, theme_alphatrade{{/str}}
                <a href="{{contacturl}}">{{#str}}contactteam, theme_alphatrade{{/str}}</a>
            </p>
        </div>
    </div>
    <footer id="page-footer" class="at-login-footer">
        {{{ output.standard_footer_html }}}
        {{{ output.standard_end_of_body_html }}}
        <button type="button" class="btn btn-link at-login-cookies" {{!
        }} data-modal="alert"{{!
        }} data-modal-title-str='["cookiesenabled", "core"]' {{!
        }} data-modal-content-str='["cookiesenabled_help_html", "core"]'{{!
        }}>{{#str}}cookiesnotice{{/str}}</button>
        <div class="footer-content-debugging footer-dark bg-dark text-light">
            <div class="container-fluid footer-dark-inner">
                {{{ output.debug_footer_html }}}
            </div>
        </div>
    </footer>
</div>

</body>
</html>
{{#js}}
M.util.js_pending('theme_boost/loader');
require(['theme_boost/loader'], function() {
  M.util.js_complete('theme_boost/loader');
});
{{/js}}
