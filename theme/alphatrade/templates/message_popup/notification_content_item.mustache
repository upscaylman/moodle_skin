{{!
    @template message_popup/notification_content_item

    Alpha Trade override (maquettes, notifications centre): Phosphor icon, title (bold while unread), time stamp and
    "View full notification" link. The title link covers the whole row (stretched), the full notification link sits
    above it: no nested links. Same data-region / data-action attributes as core for the popover JS.
    The icon depends on the notification type (_notifications.scss): ph-user-plus (application), ph-sign-in (new sign-in),
    ph-file-text (assignment), ph-chart-bar (analysis reviewed), ph-chats-circle (forum), ph-info (site notices),
    ph-bell otherwise.

    Example context (json):
    {
        "contexturl": "http://www.moodle.com",
        "read": false,
        "subject": "You have a notification",
        "id": 1,
        "component": "local_alphatrade",
        "eventtype": "newapplication",
        "shortenedsubject": "You have a...",
        "timecreatedpretty": "5 minutes ago",
        "viewmoreurl": "http://www.moodle.com"
    }
}}
<div class="content-item-container notification at-popnotif {{^read}}unread{{/read}}"
    data-region="notification-content-item-container"
    data-id="{{id}}"
    role="listitem">
    <i class="ph ph-bell at-popnotif-icon" data-component="{{component}}" data-eventtype="{{eventtype}}" aria-hidden="true"></i>
    <div class="at-popnotif-body">
        {{#contexturl}}
            <a class="context-link at-popnotif-title" href="{{{.}}}" data-action="content-item-link"{{!
                }}{{#read}} aria-label="{{subject}}"{{/read}}{{!
                }}{{^read}} aria-label="{{#str}} unreadnotification, message, {{subject}} {{/str}}"{{/read}}>{{shortenedsubject}}</a>
        {{/contexturl}}
        {{^contexturl}}
            <span class="at-popnotif-title" tabindex="0"{{!
                }}{{#read}} aria-label="{{subject}}"{{/read}}{{!
                }}{{^read}} aria-label="{{#str}} unreadnotification, message, {{subject}} {{/str}}"{{/read}}>{{shortenedsubject}}</span>
        {{/contexturl}}
        <span class="timestamp at-popnotif-time">{{timecreatedpretty}}</span>
        {{#viewmoreurl}}
            <a href="{{{.}}}" class="view-more" data-action="view-more">{{#str}} viewfullnotification, message {{/str}}</a>
        {{/viewmoreurl}}
    </div>
</div>
