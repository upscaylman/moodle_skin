{{!
    @template theme_alphatrade/mobilemenu

    Mobile menu (below lg). Uses Boost's drawer component so open/close, focus lock
    and backdrop come from theme_boost/drawers.

    Example context (json):
    {
        "sitename": "Alpha Trade",
        "homeurl": "#",
        "logourl": "logo.png",
        "nav": {"main": [], "secondary": [], "staff": [], "hasstaff": false}
    }
}}
{{< theme_boost/drawer }}
    {{$id}}theme_alphatrade-drawers-menu{{/id}}
    {{$drawerclasses}}drawer drawer-left drawer-primary alpha-mobilemenu{{/drawerclasses}}
    {{$drawercloseonresize}}1{{/drawercloseonresize}}
    {{$drawerheading}}
        <a href="{{homeurl}}" class="alpha-brand aabtn">
            <img src="{{logourl}}" class="alpha-brand-wordmark" alt="{{sitename}}">
        </a>
    {{/drawerheading}}
    {{$drawercontent}}
        {{> theme_alphatrade/navlist }}
    {{/drawercontent}}
    {{$drawerstate}}show-drawer-primary{{/drawerstate}}
{{/ theme_boost/drawer}}
