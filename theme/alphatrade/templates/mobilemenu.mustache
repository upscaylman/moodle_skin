{{!
    @template theme_alphatrade/mobilemenu

    Mobile drawer: the items that are not in the tab bar (Journal, Outils, Ressources, Communauté).

    Example context (json):
    {"nav": {"hasdrawer": true, "drawer": [{"key": "journal", "label": "Journal", "icon": "ph-notebook", "url": "#", "active": false}], "switch": [], "hasswitch": false} }
}}
{{#nav.hasdrawer}}
{{< theme_boost/drawer }}
    {{$id}}theme_alphatrade-drawers-menu{{/id}}
    {{$drawerclasses}}drawer drawer-left drawer-primary at-drawer{{/drawerclasses}}
    {{$drawercloseonresize}}1{{/drawercloseonresize}}
    {{$drawercontent}}
        <div class="at-drawer-list">
            {{#nav.drawer}}
                <a href="{{url}}" class="at-navbtn{{#active}} is-active{{/active}}" data-hoverable="{{#active}}false{{/active}}{{^active}}true{{/active}}"{{#active}} aria-current="page"{{/active}}><i class="ph {{icon}}" aria-hidden="true"></i>{{label}}</a>
            {{/nav.drawer}}
            {{#nav.hasswitch}}
                {{#nav.switch}}
                    <a href="{{url}}" class="at-navbtn" data-hoverable="true"><i class="ph {{icon}}" aria-hidden="true"></i>{{label}}</a>
                {{/nav.switch}}
            {{/nav.hasswitch}}
        </div>
    {{/drawercontent}}
    {{$drawerstate}}show-drawer-primary{{/drawerstate}}
{{/ theme_boost/drawer}}
{{/nav.hasdrawer}}
