{{!
    @template theme_alphatrade/mobtop

    Mobile top bar (860px and below): menu button, logo. Notifications and avatar are the
    header actions, pinned into this bar by CSS (no duplicated Moodle widgets).

    Example context (json):
    {"homeurl": "#", "logourl": "logo.png", "sitename": "Alpha Trade", "nav": {"hasdrawer": true} }
}}
<div class="at-mob-top d-print-none">
    {{#nav.hasdrawer}}
        <button type="button" class="btn btn-icon btn-secondary" data-toggler="drawers" data-action="toggle" data-target="theme_alphatrade-drawers-menu" aria-label="{{#str}}menu, theme_alphatrade{{/str}}">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M3 6h18M3 12h18M3 18h18"></path></svg>
        </button>
    {{/nav.hasdrawer}}
    {{^nav.hasdrawer}}<span class="at-mob-top-spacer"></span>{{/nav.hasdrawer}}
    <a class="at-mob-logo" href="{{homeurl}}"><img src="{{logourl}}" alt="{{sitename}}"></a>
    <span class="at-mob-top-spacer at-mob-top-actions-slot"></span>
</div>
