{{!
    @template theme_alphatrade/navlist

    Navigation list shared by the desktop sidebar and the mobile menu.

    Example context (json):
    {
        "nav": {
            "main": [{"key": "home", "label": "Accueil", "icon": "ph-house", "url": "#", "active": true}],
            "secondary": [],
            "staff": [{"key": "teacher", "label": "Espace formateur", "icon": "ph-chalkboard-teacher", "url": "#", "active": false}],
            "hasstaff": true
        }
    }
}}
<nav class="alpha-nav">
    <ul class="alpha-nav-list">
        {{#nav.main}}
            <li>
                <a href="{{url}}" class="alpha-nav-item{{#active}} active{{/active}}"{{#active}} aria-current="page"{{/active}}>
                    <i class="ph{{#active}}-fill{{/active}} {{icon}}" aria-hidden="true"></i>
                    <span>{{label}}</span>
                </a>
            </li>
        {{/nav.main}}
    </ul>
    <hr class="alpha-nav-separator">
    <ul class="alpha-nav-list">
        {{#nav.secondary}}
            <li>
                <a href="{{url}}" class="alpha-nav-item{{#active}} active{{/active}}"{{#active}} aria-current="page"{{/active}}>
                    <i class="ph{{#active}}-fill{{/active}} {{icon}}" aria-hidden="true"></i>
                    <span>{{label}}</span>
                </a>
            </li>
        {{/nav.secondary}}
    </ul>
    {{#nav.hasstaff}}
        <p class="alpha-nav-heading">{{#str}}nav_staffheading, theme_alphatrade{{/str}}</p>
        <ul class="alpha-nav-list">
            {{#nav.staff}}
                <li>
                    <a href="{{url}}" class="alpha-nav-item{{#active}} active{{/active}}"{{#active}} aria-current="page"{{/active}}>
                        <i class="ph{{#active}}-fill{{/active}} {{icon}}" aria-hidden="true"></i>
                        <span>{{label}}</span>
                    </a>
                </li>
            {{/nav.staff}}
        </ul>
    {{/nav.hasstaff}}
</nav>
