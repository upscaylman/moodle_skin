                            <div class="at-field at-mb-6"><label for="at-apply-why">{{#str}}pub_apply_why, theme_alphatrade{{/str}}</label><textarea class="at-input" id="at-apply-why" name="motivation" rows="4" maxlength="500" aria-describedby="at-apply-why-max" placeholder="{{#str}}pub_apply_why_ph, theme_alphatrade{{/str}}"></textarea></div>
                            <div class="at-pub-hint" id="at-apply-why-max">{{#str}}pub_apply_why_max, theme_alphatrade, 500{{/str}}</div>
                            <button type="submit" class="btn btn-primary btn-block">{{#str}}pub_apply_send, theme_alphatrade{{/str}}</button>
                        </form>
                    {{/hasform}}
                    {{^hasform}}
                        {{#hasapplyurl}}<a class="btn btn-primary btn-block" href="{{applyurl}}">{{#str}}pub_apply_send, theme_alphatrade{{/str}}</a>{{/hasapplyurl}}
                    {{/hasform}}
                {{/applied}}
                <p class="at-pub-member">{{#str}}pub_member, theme_alphatrade{{/str}} <a href="{{loginurl}}">{{#str}}pub_login, theme_alphatrade{{/str}}</a></p>
            </section>
        {{/iscandidater}}

        <div class="d-none" aria-hidden="true">{{{ output.main_content }}}</div>
    </main>

    <footer id="page-footer" class="at-pub-footer">
        <div class="at-pub-footer-cols">
            <div class="at-pub-footer-brand">
                <img src="{{logourl}}" alt="{{sitename}}" loading="lazy" decoding="async">
                <span>{{#str}}pub_tagline, theme_alphatrade{{/str}}</span>
            </div>
            <div class="at-pub-footer-col">
                <div class="at-pub-footer-title">{{#str}}pub_footer_links, theme_alphatrade{{/str}}</div>
                <a href="{{programmeurl}}">{{#str}}pub_nav_programme, theme_alphatrade{{/str}}</a>
                <a href="{{methodeurl}}">{{#str}}pub_nav_methode, theme_alphatrade{{/str}}</a>
                <a href="{{teamurl}}">{{#str}}pub_nav_formateurs, theme_alphatrade{{/str}}</a>
                <a href="{{faqurl}}">{{#str}}pub_nav_faq, theme_alphatrade{{/str}}</a>
                {{#hasdiscord}}<a class="at-pub-discord" href="{{discordurl}}" target="_blank" rel="noopener"><i class="ph ph-discord-logo" aria-hidden="true"></i>{{#str}}pub_nav_communaute, theme_alphatrade{{/str}}</a>{{/hasdiscord}}
            </div>
            {{#hasinstagram}}
                <div class="at-pub-footer-col">
                    <div class="at-pub-footer-title">{{#str}}pub_footer_follow, theme_alphatrade{{/str}}</div>
                    <a href="{{instagramurl}}" target="_blank" rel="noopener"><i class="ph ph-instagram-logo" aria-hidden="true"></i>Instagram</a>
                </div>
            {{/hasinstagram}}
            <div class="at-pub-footer-col">
                <div class="at-pub-footer-title">{{#str}}pub_footer_contact, theme_alphatrade{{/str}}</div>
                {{#hascontactemail}}<a href="mailto:{{contactemail}}"><i class="ph ph-envelope-simple" aria-hidden="true"></i>{{contactemail}}</a>{{/hascontactemail}}
                {{#hascontactphone}}<a href="tel:{{contactphone}}"><i class="ph ph-phone" aria-hidden="true"></i>{{contactphone}}</a>{{/hascontactphone}}
            </div>
        </div>
        <div class="at-pub-footer-standard">
            {{{ output.standard_footer_html }}}
            {{{ output.standard_end_of_body_html }}}
        </div>
    </footer>
</div>
</body>
</html>
{{#js}}
M.util.js_pending('theme_boost/loader');
require(['theme_boost/loader'], function() {
    M.util.js_complete('theme_boost/loader');
});

(function() {
    // Chiffres du programme : comptage de 0 a la valeur finale (easing cubic-out, 1.1 s).
    // Mouvement reduit : la valeur finale est posee directement.
    var counters = document.querySelectorAll('.at-pub-stat-n[data-count]');
    if (!counters.length) {
        return;
    }
    var slow = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    counters.forEach(function(counter) {
        var target = parseInt(counter.getAttribute('data-count'), 10) || 0;
        if (slow || !window.requestAnimationFrame) {
            counter.textContent = target;
            return;
        }
        var start = null;
        var step = function(now) {
            if (start === null) {
                start = now;
            }
            var progress = Math.min(1, (now - start) / 1100);
            var eased = 1 - Math.pow(1 - progress, 3);
            counter.textContent = Math.round(target * eased);
            if (progress < 1) {
                window.requestAnimationFrame(step);
            }
        };
        window.requestAnimationFrame(step);
    });
})();

(function() {
    var reduced = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    // Cross-fade helper: one active item at a time, inactive items hidden from assistive technologies.
    var show = function(items, index) {
        items.forEach(function(item, i) {
            item.classList.toggle('is-active', i === index);
            if (i === index) {
                item.removeAttribute('aria-hidden');
            } else {
                item.setAttribute('aria-hidden', 'true');
            }
        });
    };

    // Hero headline (kicker + title + subtitle) alternating every 5 s, re-entering with at-headline-fade.
    var headline = document.querySelector('.at-pub-headline[data-headlines]');
    if (headline && !reduced) {
        var variants = [];
        try {
            variants = JSON.parse(headline.getAttribute('data-headlines'));
        } catch (e) {
            variants = [];
        }
        if (variants.length > 1) {
            var current = 0;
            setInterval(function() {
                current = (current + 1) % variants.length;
                ['kicker', 'title', 'subtitle'].forEach(function(field) {
                    var el = headline.querySelector('[data-field="' + field + '"]');
                    if (el) {
                        el.textContent = variants[current][field];
                    }
                });
                headline.classList.remove('is-animating');
                void headline.offsetWidth;
                headline.classList.add('is-animating');
            }, 5000);
        }
    }

    // Hero carousel: cross-fade every 4.5 s, dots to navigate.
    var carousel = document.querySelector('.at-pub-carousel.is-rotating');
    if (carousel) {
        var slides = Array.prototype.slice.call(carousel.querySelectorAll('.at-pub-slide'));
        var dots = Array.prototype.slice.call(carousel.querySelectorAll('.at-pub-dot'));
        var active = 0;
        var timer = null;
        var go = function(index) {
            active = index;
            show(slides, index);
            dots.forEach(function(dot, i) {
                dot.classList.toggle('is-active', i === index);
                if (i === index) {
                    dot.setAttribute('aria-current', 'true');
                } else {
                    dot.removeAttribute('aria-current');
                }
            });
        };
        var start = function() {
            if (reduced) {
                return;
            }
            clearInterval(timer);
            timer = setInterval(function() {
                go((active + 1) % slides.length);
            }, 4500);
        };
        dots.forEach(function(dot) {
            dot.addEventListener('click', function() {
                go(parseInt(dot.getAttribute('data-slide'), 10));
                start();
            });
        });
        start();
    }
})();
{{/js}}
