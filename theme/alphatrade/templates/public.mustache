{{!
    @template theme_alphatrade/public

    Maquette "Alpha Trade - Site Public". Moodle's own site home content is rendered but hidden
    (the layout must print main_content). Head: theme_alphatrade/public_head (SEO and link previews).

    Example context (json):
    {
        "sitename": "Alpha Trade",
        "output": {"favicon": "favicon.ico", "main_content": ""},
        "doctype": "<!DOCTYPE html>", "htmlattributes": "lang=\"fr\"", "headhtml": "",
        "seo": {"title": "Alpha Trade Academy", "description": "École de trading", "canonical": "#", "sitename": "Alpha Trade Academy",
            "locale": "fr_FR", "image": "share-logo.jpg", "imagesize": 600, "imagealt": "Logo", "indexable": true, "llms": "#", "jsonld": "{}" },
        "bodyattributes": "", "markurl": "mark.png", "logourl": "logo.png", "heroimageurl": "hero.jpg", "loginurl": "#",
        "haspubnav": true, "pubnav": [{"label": "Accueil", "url": "#", "active": true}],
        "homeurl": "#", "programmeurl": "#", "teamurl": "#", "candidaterurl": "#",
        "isaccueil": true, "isprogramme": false, "ismethode": false, "isformateurs": false, "isfaq": false, "iscandidater": false,
        "pipeline": [{"label": "Comprendre", "icon": "ph-book-open", "hasarrow": true}],
        "months": [{"number": 1, "label": "Comprendre", "summary": "Fondamentaux", "modules": [{"number": "01", "title": "Fondamentaux des marchés", "desc": "Marchés"}]}],
        "method": [{"number": 1, "title": "Comprendre", "desc": "Les mécanismes"}],
        "team": [{"initials": "NM", "name": "Nesrine Moussa", "role": "Théorie des marchés · Psychologie", "bio": "Enseigne"}],
        "faq": [{"question": "Signaux ?", "answer": "Non."}],
        "hasfacts": true, "facts": [{"key": "format", "icon": "ph-laptop", "label": "Format", "value": "En ligne"}],
        "levels": [{"value": "beginner", "label": "Débutant"}],
        "hasform": true, "applyurl": "", "hasapplyurl": false, "formaction": "#", "sesskey": "x", "applied": false, "programmepdfurl": "#",
        "headline": {"kicker": "École de trading & investissement", "title": "Comprendre les marchés.", "subtitle": "Un programme intensif."},
        "headlinesjson": "[]",
        "hasslides": true, "slides": [{"url": "hero-slide-1.png", "alt": "Image", "label": "Image 1", "index": 0, "first": true}]
    }
}}
{{> theme_alphatrade/public_head }}

<body {{{ bodyattributes }}}>
{{> core/local/toast/wrapper}}
<div id="page-wrapper" class="at-public">
    {{{ output.standard_top_of_body_html }}}
    {{< theme_alphatrade/pub_header }}
        {{$actions}}
            <div class="at-pub-actions">
                <a class="btn btn-secondary" href="{{loginurl}}">{{#str}}pub_login, theme_alphatrade{{/str}}</a>
                <a class="btn btn-primary" href="{{candidaterurl}}">{{#str}}pub_apply, theme_alphatrade{{/str}}</a>
            </div>
        {{/actions}}
    {{/ theme_alphatrade/pub_header }}

    <main id="page" class="at-pub-main">
        {{#isaccueil}}
            <section class="at-pub-hero">
                {{! Headline variants alternate every 5 s: the block re-enters with at-headline-fade (0.6 s). }}
                <div class="at-pub-headline is-animating" data-headlines="{{headlinesjson}}">
                    {{#headline}}
                        <span class="at-pub-chip" data-field="kicker">{{kicker}}</span>
                        <h1 data-field="title">{{title}}</h1>
                        <p data-field="subtitle">{{subtitle}}</p>
                    {{/headline}}
                    <div class="at-pub-buttons">
                        <a class="btn btn-primary" href="{{candidaterurl}}">{{#str}}pub_apply, theme_alphatrade{{/str}}</a>
                        <a class="btn btn-secondary" href="{{programmeurl}}">{{#str}}pub_discover, theme_alphatrade{{/str}}</a>
                        <a class="btn btn-ghost" href="{{programmepdfurl}}" download><i class="ph ph-download-simple" aria-hidden="true"></i>{{#str}}pub_download_programme, theme_alphatrade{{/str}}</a>
                    </div>
                </div>
                {{! Hero carousel: stacked images, opacity cross-fade (0.8 s) every 4.5 s. }}
                <div class="at-pub-hero-img at-pub-carousel{{#hasslides}} is-rotating{{/hasslides}}">
                    {{#slides}}<img class="at-pub-slide{{#first}} is-active{{/first}}" src="{{url}}" alt="{{alt}}"{{#first}} fetchpriority="high"{{/first}}{{^first}} aria-hidden="true"{{/first}} decoding="async">{{/slides}}
                    {{#hasslides}}
                        <div class="at-pub-dots" role="group" aria-label="{{#str}}pub_slides, theme_alphatrade{{/str}}">
                            {{#slides}}<button type="button" class="at-pub-dot{{#first}} is-active{{/first}}" data-slide="{{index}}" aria-label="{{label}}"{{#first}} aria-current="true"{{/first}}></button>{{/slides}}
                        </div>
                    {{/hasslides}}
                </div>
            </section>

            {{! Chiffres du programme : comptent de 0 a leur valeur au chargement, ligne de tendance en filigrane. }}
            <section class="at-pub-stats" data-region="at-pub-stats">
                <svg class="at-pub-stats-line" viewBox="0 0 600 120" preserveAspectRatio="none" aria-hidden="true">
                    <path d="M0 104 L120 88 L240 92 L360 52 L480 44 L600 12" fill="none" stroke="currentColor" stroke-width="3"></path>
                </svg>
                {{#stats}}
                    <div class="at-pub-stat">
                        <div class="at-pub-stat-n" data-count="{{value}}">0</div>
                        <div class="at-pub-stat-label">{{label}}</div>
                    </div>
                {{/stats}}
            </section>

            <section class="at-pub-band">
                <div class="at-pub-pipeline">
                    {{#pipeline}}
                        <span class="at-pub-step">
                            <span class="at-pub-pill"><i class="ph {{icon}}" aria-hidden="true"></i>{{label}}</span>
                            {{#hasarrow}}<i class="ph ph-arrow-right at-pub-arrow" aria-hidden="true"></i>{{/hasarrow}}
                        </span>
                    {{/pipeline}}
                </div>
            </section>

            <section class="at-pub-section">
                <div class="at-pub-section-head">
                    <h2>{{#str}}pub_programme_title, theme_alphatrade{{/str}}</h2>
                    <a href="{{programmeurl}}">{{#str}}pub_programme_link, theme_alphatrade{{/str}} &rarr;</a>
                </div>
                <div class="at-pub-grid">
                    {{#monthcards}}
                        <div class="at-card at-elev-sm at-pub-monthcard">
                            <span class="at-pub-monthicon" aria-hidden="true"><i class="ph {{icon}}"></i></span>
                            <div class="at-pub-monthhead">
                                <span class="at-card-kicker">{{#str}}pub_month, theme_alphatrade, {{number}}{{/str}}</span>
                                <span class="at-tag at-tag-neutral">{{level}}</span>
                            </div>
                            <h3 class="at-card-title">{{label}}</h3>
                            <p class="at-card-body">{{summary}}</p>
                            <a class="btn btn-secondary at-pub-monthbtn" href="{{url}}">{{#str}}pub_seecourse, theme_alphatrade{{/str}} &rarr;</a>
                        </div>
                    {{/monthcards}}
                </div>
            </section>

            <section class="at-pub-section at-pub-invest">
                <div class="at-pub-invest-text">
                    <span class="at-pub-chip">{{#str}}pub_invest_kicker, theme_alphatrade{{/str}}</span>
                    <h2>{{#str}}pub_invest_title, theme_alphatrade{{/str}}</h2>
                    <div class="at-pub-investlist">
                        <div class="at-pub-investline">
                            <i class="ph ph-file-text" aria-hidden="true"></i>
                            <div><div class="at-pub-investtitle">{{#str}}pub_invest_1, theme_alphatrade{{/str}}</div><div class="at-pub-investdesc">{{#str}}pub_invest_1_desc, theme_alphatrade{{/str}}</div></div>
                        </div>
                        <div class="at-pub-investline">
                            <i class="ph ph-tree-structure" aria-hidden="true"></i>
                            <div><div class="at-pub-investtitle">{{#str}}pub_invest_2, theme_alphatrade{{/str}}</div><div class="at-pub-investdesc">{{#str}}pub_invest_2_desc, theme_alphatrade{{/str}}</div></div>
                        </div>
                        <div class="at-pub-investline">
                            <i class="ph ph-target" aria-hidden="true"></i>
                            <div><div class="at-pub-investtitle">{{#str}}pub_invest_3, theme_alphatrade{{/str}}</div><div class="at-pub-investdesc">{{#str}}pub_invest_3_desc, theme_alphatrade{{/str}}</div></div>
                        </div>
                    </div>
                </div>
                <div class="at-pub-invest-img">
                    <img src="{{heroimageurl}}" alt="{{#str}}pub_hero_alt, theme_alphatrade{{/str}}" loading="lazy" decoding="async">
                </div>
            </section>

            <section class="at-pub-section is-bordered">
                <div class="at-pub-section-head">
                    <h2>{{#str}}pub_team_title, theme_alphatrade{{/str}}</h2>
                    <a href="{{teamurl}}">{{#str}}pub_team_link, theme_alphatrade{{/str}} &rarr;</a>
                </div>
                <div class="at-pub-grid">
                    {{#team}}
                        <div class="at-card at-elev-sm at-pub-person">
                            {{#hasphoto}}<img class="at-pub-avatar" src="{{photo}}" alt="{{name}}" loading="lazy" decoding="async">{{/hasphoto}}
                            {{^hasphoto}}<span class="at-pub-initials" aria-hidden="true">{{initials}}</span>{{/hasphoto}}
                            <div><h3 class="at-card-title">{{name}}</h3><div class="at-card-meta">{{role}}</div></div>
                        </div>
                    {{/team}}
                </div>
            </section>

            <section class="at-pub-cta">
                <h2>{{#str}}pub_cta_title, theme_alphatrade{{/str}}</h2>
                <p>{{#str}}pub_cta_lead, theme_alphatrade{{/str}}</p>
                <a class="btn btn-primary" href="{{candidaterurl}}">{{#str}}pub_apply, theme_alphatrade{{/str}}</a>
            </section>
        {{/isaccueil}}

        {{#isprogramme}}
            <section class="at-pub-page is-960">
                <span class="at-pub-chip">{{#str}}pub_programme_tag, theme_alphatrade{{/str}}</span>
                <h1>{{#str}}pub_programme_h1, theme_alphatrade{{/str}}</h1>
                <p class="at-pub-lead">{{#str}}pub_programme_lead, theme_alphatrade{{/str}}</p>
                {{#hasfacts}}
                    <dl class="at-pub-facts">
                        {{#facts}}
                            <div class="at-card at-elev-sm at-pub-fact">
                                <i class="ph {{icon}}" aria-hidden="true"></i>
                                <div><dt>{{label}}</dt><dd>{{value}}</dd></div>
                            </div>
                        {{/facts}}
                    </dl>
                {{/hasfacts}}
                {{#months}}
                    <div class="at-pub-month">
                        <div class="at-eyebrow">{{#str}}pub_month_upper, theme_alphatrade, {{number}}{{/str}}</div>
                        <div class="at-pub-month-label">{{label}}</div>
                        <div class="at-stack-8">
                            {{#modules}}
                                <div class="at-card at-elev-sm at-pub-module">
                                    <span class="at-pub-module-n">{{number}}</span>
                                    <div><div class="at-pub-module-title">{{title}}</div><div class="at-pub-module-desc">{{desc}}</div></div>
                                </div>
                            {{/modules}}
                        </div>
                    </div>
                {{/months}}
                <div class="at-pub-center">
                    <a class="btn btn-primary" href="{{candidaterurl}}">{{#str}}pub_apply, theme_alphatrade{{/str}}</a>
                    <a class="btn btn-secondary" href="{{programmepdfurl}}" download><i class="ph ph-download-simple" aria-hidden="true"></i>{{#str}}pub_download_programme, theme_alphatrade{{/str}}</a>
                </div>
            </section>
        {{/isprogramme}}

        {{#ismethode}}
            <section class="at-pub-page is-900">
                <span class="at-pub-chip">{{#str}}pub_nav_methode, theme_alphatrade{{/str}}</span>
                <h1>{{#str}}pub_method_h1, theme_alphatrade{{/str}}</h1>
                <p class="at-pub-lead">{{#str}}pub_method_lead, theme_alphatrade{{/str}}</p>
                <div class="at-pub-steps">
                    {{#method}}
                        <div class="at-pub-stepline">
                            <span class="at-pub-stepnum" aria-hidden="true">{{number}}</span>
                            <div><div class="at-pub-steptitle">{{title}}</div><div class="at-pub-stepdesc">{{desc}}</div></div>
                        </div>
                    {{/method}}
                </div>
                <div class="at-card at-elev-sm at-pub-warning">
                    <i class="ph ph-warning" aria-hidden="true"></i>
                    <span>{{#str}}pub_method_warning, theme_alphatrade{{/str}}</span>
                </div>
            </section>
        {{/ismethode}}

        {{#isformateurs}}
            <section class="at-pub-page is-900">
                <span class="at-pub-chip">{{#str}}pub_nav_formateurs, theme_alphatrade{{/str}}</span>
                <h1>{{#str}}pub_team_h1, theme_alphatrade{{/str}}</h1>
                <p class="at-pub-lead">{{#str}}pub_team_lead, theme_alphatrade{{/str}}</p>
                <div class="at-pub-grid is-320">
                    {{#team}}
                        <div class="at-card at-elev-sm at-pub-trainer">
                            {{#hasphoto}}<img class="at-pub-photo" src="{{photo}}" alt="{{name}}" loading="lazy" decoding="async">{{/hasphoto}}
                            {{^hasphoto}}<span class="at-pub-photo" aria-hidden="true">{{initials}}</span>{{/hasphoto}}
                            <h3 class="at-card-title">{{name}}</h3>
                            <div class="at-card-meta at-mb-10">{{role}}</div>
                            <p class="at-card-body">{{bio}}</p>
                        </div>
                    {{/team}}
                </div>
            </section>
        {{/isformateurs}}

        {{#iscours}}
            {{#course}}
                <section class="at-pub-page is-900 at-pub-course">
                    <a class="at-pub-back" href="{{programmeurl}}">&larr; {{#str}}pub_course_back, theme_alphatrade{{/str}}</a>
                    <div class="at-pub-coursehead">
                        <div class="at-pub-coursemedia">
                            {{#trainer}}{{#hasphoto}}<img src="{{photo}}" alt="{{name}}" loading="lazy" decoding="async">{{/hasphoto}}{{/trainer}}
                            <span class="at-pub-courseicon" aria-hidden="true"><i class="ph {{icon}}"></i></span>
                        </div>
                        <dl class="at-pub-coursestats">
                            {{#stats}}
                                <div class="at-card at-elev-sm at-pub-coursestat"><dt>{{label}}</dt><dd>{{value}}</dd></div>
                            {{/stats}}
                        </dl>
                    </div>
                    <span class="at-pub-chip">{{kicker}}</span>
                    <h1>{{title}}</h1>
                    <p class="at-pub-lead">{{desc}}</p>
                    <div class="at-pub-center at-pub-coursecta">
                        <a class="btn btn-primary" href="{{candidaterurl}}">{{#str}}pub_apply, theme_alphatrade{{/str}} &rarr;</a>
                    </div>
                    <h2 class="at-pub-coursesub">{{#str}}pub_course_included, theme_alphatrade{{/str}}</h2>
                    <div class="at-stack-8">
                        {{#modules}}
                            <div class="at-card at-elev-sm at-pub-module">
                                <span class="at-pub-module-n">{{number}}</span>
                                <div><div class="at-pub-module-title">{{title}}</div><div class="at-pub-module-desc">{{desc}}</div></div>
                            </div>
                        {{/modules}}
                    </div>
                    {{#trainer}}
                        <h2 class="at-pub-coursesub">{{#str}}pub_course_trainer, theme_alphatrade{{/str}}</h2>
                        <div class="at-card at-elev-sm at-pub-trainercard">
                            {{#hasphoto}}<img class="at-pub-avatar" src="{{photo}}" alt="{{name}}" loading="lazy" decoding="async">{{/hasphoto}}
                            {{^hasphoto}}<span class="at-pub-initials" aria-hidden="true">{{initials}}</span>{{/hasphoto}}
                            <div>
                                <h3 class="at-card-title">{{name}}</h3>
                                <div class="at-card-meta at-mb-10">{{role}}</div>
                                <p class="at-card-body">{{approach}}</p>
                            </div>
                        </div>
                    {{/trainer}}
                </section>
            {{/course}}
        {{/iscours}}

        {{#isfaq}}
