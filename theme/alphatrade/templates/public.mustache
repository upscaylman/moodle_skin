{{!
    @template theme_alphatrade/public

    Maquette "Alpha Trade - Site Public". Moodle's own site home content is rendered but hidden
    (the layout must print main_content).

    Example context (json):
    {
        "sitename": "Alpha Trade",
        "output": {"doctype": "<!DOCTYPE html>", "page_title": "Alpha Trade", "favicon": "favicon.ico", "main_content": ""},
        "bodyattributes": "", "markurl": "mark.png", "logourl": "logo.png", "heroimageurl": "hero.jpg", "loginurl": "#",
        "nav": [{"label": "Accueil", "url": "#", "active": true}],
        "homeurl": "#", "programmeurl": "#", "teamurl": "#", "candidaterurl": "#",
        "isaccueil": true, "isprogramme": false, "ismethode": false, "isformateurs": false, "isfaq": false, "iscandidater": false,
        "pipeline": [{"label": "Comprendre", "icon": "ph-book-open", "hasarrow": true}],
        "months": [{"number": 1, "label": "Comprendre", "summary": "Fondamentaux", "modules": [{"number": "01", "title": "Fondamentaux des marchés", "desc": "Marchés"}]}],
        "method": [{"number": 1, "title": "Comprendre", "desc": "Les mécanismes"}],
        "team": [{"initials": "NM", "name": "Nesrine Moussa", "role": "Théorie des marchés · Psychologie", "bio": "Enseigne"}],
        "faq": [{"question": "Signaux ?", "answer": "Non."}],
        "hasform": true, "applyurl": "", "hasapplyurl": false, "formaction": "#", "sesskey": "x", "applied": false
    }
}}
{{> theme_boost/head }}

<body {{{ bodyattributes }}}>
{{> core/local/toast/wrapper}}
<div id="page-wrapper" class="at-public">
    {{{ output.standard_top_of_body_html }}}
    <div class="at-blob at-blob-page" aria-hidden="true"></div>

    <header class="at-pub-header">
        <a class="at-pub-mark" href="{{homeurl}}"><img src="{{markurl}}" alt="{{sitename}}"></a>
        <nav class="at-pub-nav" aria-label="{{sitename}}">
            {{#nav}}<a href="{{url}}"{{#active}} aria-current="page"{{/active}}>{{label}}</a>{{/nav}}
        </nav>
        <div class="at-pub-actions">
            <a class="btn btn-secondary" href="{{loginurl}}">{{#str}}pub_login, theme_alphatrade{{/str}}</a>
            <a class="btn btn-primary" href="{{candidaterurl}}">{{#str}}pub_apply, theme_alphatrade{{/str}}</a>
        </div>
    </header>

    <main id="page" class="at-pub-main">
        {{#isaccueil}}
            <section class="at-pub-hero">
                <div>
                    <span class="at-tag at-tag-outline at-pub-kicker">{{#str}}pub_hero_tag, theme_alphatrade{{/str}}</span>
                    <h1>{{#str}}pub_hero_title, theme_alphatrade{{/str}}</h1>
                    <p>{{#str}}pub_hero_lead, theme_alphatrade{{/str}}</p>
                    <div class="at-pub-buttons">
                        <a class="btn btn-primary" href="{{candidaterurl}}">{{#str}}pub_apply, theme_alphatrade{{/str}}</a>
                        <a class="btn btn-secondary" href="{{programmeurl}}">{{#str}}pub_discover, theme_alphatrade{{/str}}</a>
                    </div>
                </div>
                <div class="at-pub-hero-img"><img src="{{heroimageurl}}" alt="{{#str}}pub_hero_alt, theme_alphatrade{{/str}}"></div>
            </section>

            <section class="at-pub-band">
                <div class="at-pub-pipeline">
                    {{#pipeline}}
                        <span class="at-pub-step">
                            <span class="at-pub-pill"><i class="ph {{icon}}" aria-hidden="true"></i>{{label}}</span>
                            {{#hasarrow}}<i class="ph ph-arrow-right at-pub-arrow" aria-hidden="true"></i>{{/hasarrow}}
                        </span>
                    {{/pipeline}}
                </div>
            </section>

            <section class="at-pub-section">
                <div class="at-pub-section-head">
                    <h2>{{#str}}pub_programme_title, theme_alphatrade{{/str}}</h2>
                    <a href="{{programmeurl}}">{{#str}}pub_programme_link, theme_alphatrade{{/str}} &rarr;</a>
                </div>
                <div class="at-pub-grid">
                    {{#months}}
                        <div class="at-card at-elev-sm at-pad-22">
                            <span class="at-card-kicker">{{#str}}pub_month, theme_alphatrade, {{number}}{{/str}}</span>
                            <h4 class="at-card-title at-mt-2">{{label}}</h4>
                            <p class="at-card-body">{{summary}}</p>
                        </div>
                    {{/months}}
                </div>
            </section>

            <section class="at-pub-section is-bordered">
                <div class="at-pub-section-head">
                    <h2>{{#str}}pub_team_title, theme_alphatrade{{/str}}</h2>
                    <a href="{{teamurl}}">{{#str}}pub_team_link, theme_alphatrade{{/str}} &rarr;</a>
                </div>
                <div class="at-pub-grid">
                    {{#team}}
                        <div class="at-card at-elev-sm at-pad-22 at-pub-person">
                            <span class="at-pub-initials" aria-hidden="true">{{initials}}</span>
                            <div><h4 class="at-card-title">{{name}}</h4><div class="at-card-meta">{{role}}</div></div>
                        </div>
                    {{/team}}
                </div>
            </section>

            <section class="at-pub-cta">
                <h2>{{#str}}pub_cta_title, theme_alphatrade{{/str}}</h2>
                <p>{{#str}}pub_cta_lead, theme_alphatrade{{/str}}</p>
                <a class="btn btn-primary" href="{{candidaterurl}}">{{#str}}pub_apply, theme_alphatrade{{/str}}</a>
            </section>
        {{/isaccueil}}

        {{#isprogramme}}
            <section class="at-pub-page is-960">
                <span class="at-tag at-tag-outline at-pub-kicker">{{#str}}pub_programme_tag, theme_alphatrade{{/str}}</span>
                <h1>{{#str}}pub_programme_h1, theme_alphatrade{{/str}}</h1>
                <p class="at-pub-lead">{{#str}}pub_programme_lead, theme_alphatrade{{/str}}</p>
                {{#months}}
                    <div class="at-pub-month">
                        <div class="at-eyebrow">{{#str}}pub_month_upper, theme_alphatrade, {{number}}{{/str}}</div>
                        <div class="at-pub-month-label">{{label}}</div>
                        <div class="at-stack-8">
                            {{#modules}}
                                <div class="at-card at-elev-sm at-pub-module">
                                    <span class="at-pub-module-n">{{number}}</span>
                                    <div><div class="at-pub-module-title">{{title}}</div><div class="at-pub-module-desc">{{desc}}</div></div>
                                </div>
                            {{/modules}}
                        </div>
                    </div>
                {{/months}}
                <div class="at-pub-center"><a class="btn btn-primary" href="{{candidaterurl}}">{{#str}}pub_apply, theme_alphatrade{{/str}}</a></div>
            </section>
        {{/isprogramme}}

        {{#ismethode}}
            <section class="at-pub-page is-900">
                <span class="at-tag at-tag-outline at-pub-kicker">{{#str}}pub_nav_methode, theme_alphatrade{{/str}}</span>
                <h1>{{#str}}pub_method_h1, theme_alphatrade{{/str}}</h1>
                <p class="at-pub-lead">{{#str}}pub_method_lead, theme_alphatrade{{/str}}</p>
                <div class="at-pub-steps">
                    {{#method}}
                        <div class="at-pub-stepline">
                            <span class="at-pub-stepnum" aria-hidden="true">{{number}}</span>
                            <div><div class="at-pub-steptitle">{{title}}</div><div class="at-pub-stepdesc">{{desc}}</div></div>
                        </div>
                    {{/method}}
                </div>
                <div class="at-card at-elev-sm at-pub-warning">
                    <i class="ph ph-warning" aria-hidden="true"></i>
                    <span>{{#str}}pub_method_warning, theme_alphatrade{{/str}}</span>
                </div>
            </section>
        {{/ismethode}}

        {{#isformateurs}}
            <section class="at-pub-page is-900">
                <span class="at-tag at-tag-outline at-pub-kicker">{{#str}}pub_nav_formateurs, theme_alphatrade{{/str}}</span>
                <h1>{{#str}}pub_team_h1, theme_alphatrade{{/str}}</h1>
                <p class="at-pub-lead">{{#str}}pub_team_lead, theme_alphatrade{{/str}}</p>
                <div class="at-pub-grid is-320">
                    {{#team}}
                        <div class="at-card at-elev-sm at-pub-trainer">
                            <span class="at-pub-photo" aria-hidden="true">{{initials}}</span>
                            <h3 class="at-card-title">{{name}}</h3>
                            <div class="at-card-meta at-mb-10">{{role}}</div>
                            <p class="at-card-body">{{bio}}</p>
                        </div>
                    {{/team}}
                </div>
            </section>
        {{/isformateurs}}

        {{#isfaq}}
            <section class="at-pub-page is-760">
                <span class="at-tag at-tag-outline at-pub-kicker">FAQ</span>
                <h1 class="at-pub-faq-h1">{{#str}}pub_faq_h1, theme_alphatrade{{/str}}</h1>
                <div class="at-pub-faq">
                    {{#faq}}
                        <details>
                            <summary>{{question}}</summary>
                            <p>{{answer}}</p>
                        </details>
                    {{/faq}}
                </div>
            </section>
        {{/isfaq}}

        {{#iscandidater}}
            <section class="at-pub-page is-560">
                <span class="at-tag at-tag-outline at-pub-kicker">{{#str}}pub_apply, theme_alphatrade{{/str}}</span>
                <h1 class="at-pub-apply-h1">{{#str}}pub_apply_h1, theme_alphatrade{{/str}}</h1>
                <p class="at-pub-lead">{{#str}}pub_apply_lead, theme_alphatrade{{/str}}</p>
                {{#applied}}
                    <div class="at-card at-elev-sm at-pad-22 at-pub-applied">
                        <i class="ph-fill ph-check-circle" aria-hidden="true"></i>
                        <span>{{#str}}pub_apply_done, theme_alphatrade{{/str}}</span>
                    </div>
                {{/applied}}
                {{^applied}}
                    {{#hasform}}
                        <form class="at-card at-elev-sm at-pad-24" method="post" action="{{formaction}}">
                            <input type="hidden" name="sesskey" value="{{sesskey}}">
                            <div class="at-hp" aria-hidden="true"><label for="at-apply-website">Website</label><input type="text" id="at-apply-website" name="website" tabindex="-1" autocomplete="off"></div>
                            <div class="at-field at-mb-14"><label for="at-apply-name">{{#str}}pub_apply_name, theme_alphatrade{{/str}}</label><input class="at-input" id="at-apply-name" type="text" name="fullname" required maxlength="120" autocomplete="name" placeholder="{{#str}}pub_apply_name_ph, theme_alphatrade{{/str}}"></div>
                            <div class="at-field at-mb-14"><label for="at-apply-email">{{#str}}email{{/str}}</label><input class="at-input" id="at-apply-email" type="email" name="email" required maxlength="120" autocomplete="email" placeholder="vous@email.com"></div>
                            <div class="at-field at-mb-14"><label for="at-apply-phone">{{#str}}pub_apply_phone, theme_alphatrade{{/str}}</label><input class="at-input" id="at-apply-phone" type="tel" name="phone" maxlength="40" autocomplete="tel" placeholder="+33 6 00 00 00 00"></div>
                            <div class="at-field at-mb-20"><label for="at-apply-why">{{#str}}pub_apply_why, theme_alphatrade{{/str}}</label><input class="at-input" id="at-apply-why" type="text" name="motivation" maxlength="1000" placeholder="{{#str}}pub_apply_why_ph, theme_alphatrade{{/str}}"></div>
                            <button type="submit" class="btn btn-primary btn-block">{{#str}}pub_apply_send, theme_alphatrade{{/str}}</button>
                        </form>
                    {{/hasform}}
                    {{^hasform}}
                        {{#hasapplyurl}}<a class="btn btn-primary btn-block" href="{{applyurl}}">{{#str}}pub_apply_send, theme_alphatrade{{/str}}</a>{{/hasapplyurl}}
                    {{/hasform}}
                {{/applied}}
                <p class="at-pub-member">{{#str}}pub_member, theme_alphatrade{{/str}} <a href="{{loginurl}}">{{#str}}pub_login, theme_alphatrade{{/str}}</a></p>
            </section>
        {{/iscandidater}}

        <div class="d-none" aria-hidden="true">{{{ output.main_content }}}</div>
    </main>

    <footer id="page-footer" class="at-pub-footer">
        <img src="{{logourl}}" alt="{{sitename}}">
        <span>{{#str}}pub_tagline, theme_alphatrade{{/str}}</span>
        <div class="at-pub-footer-standard">
            {{{ output.standard_footer_html }}}
            {{{ output.standard_end_of_body_html }}}
        </div>
    </footer>
</div>
</body>
</html>
{{#js}}
M.util.js_pending('theme_boost/loader');
require(['theme_boost/loader'], function() {
    M.util.js_complete('theme_boost/loader');
});
{{/js}}
