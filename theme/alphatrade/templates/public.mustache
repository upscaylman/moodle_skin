                <span class="at-pub-chip">FAQ</span>
                <h1 class="at-pub-faq-h1">{{#str}}pub_faq_h1, theme_alphatrade{{/str}}</h1>
                <div class="at-pub-faq">
                    {{#faq}}
                        <details>
                            <summary>{{question}}</summary>
                            <p>{{answer}}</p>
                        </details>
                    {{/faq}}
                </div>
            </section>
        {{/isfaq}}

        {{#iscandidater}}
            <section class="at-pub-page is-560">
                <span class="at-pub-chip">{{#str}}pub_apply, theme_alphatrade{{/str}}</span>
                <h1 class="at-pub-apply-h1">{{#str}}pub_apply_h1, theme_alphatrade{{/str}}</h1>
                <p class="at-pub-lead">{{#str}}pub_apply_lead, theme_alphatrade{{/str}}</p>
                {{#applied}}
                    <div class="at-card at-elev-sm at-pad-22 at-pub-applied">
                        <i class="ph-fill ph-check-circle" aria-hidden="true"></i>
                        <span>{{#str}}pub_apply_done, theme_alphatrade{{/str}}</span>
                    </div>
                {{/applied}}
                {{^applied}}
                    {{#hasform}}
                        <form class="at-card at-elev-sm at-pad-24" method="post" action="{{formaction}}">
                            <input type="hidden" name="sesskey" value="{{sesskey}}">
                            <div class="at-hp" aria-hidden="true"><label for="at-apply-website">Website</label><input type="text" id="at-apply-website" name="website" tabindex="-1" autocomplete="off"></div>
                            <div class="at-field at-mb-14"><label for="at-apply-name">{{#str}}pub_apply_name, theme_alphatrade{{/str}}</label><input class="at-input" id="at-apply-name" type="text" name="fullname" required maxlength="120" autocomplete="name" placeholder="{{#str}}pub_apply_name_ph, theme_alphatrade{{/str}}"></div>
                            <div class="at-field at-mb-14"><label for="at-apply-email">{{#str}}email{{/str}}</label><input class="at-input" id="at-apply-email" type="email" name="email" required maxlength="120" autocomplete="email" placeholder="vous@email.com"></div>
                            <div class="at-field at-mb-14"><label for="at-apply-phone">{{#str}}pub_apply_phone, theme_alphatrade{{/str}}</label><input class="at-input" id="at-apply-phone" type="tel" name="phone" maxlength="40" autocomplete="tel" placeholder="+33 6 00 00 00 00"></div>
                            <div class="at-field at-mb-14" role="radiogroup" aria-labelledby="at-apply-level">
