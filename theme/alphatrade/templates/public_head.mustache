{{!
    @template theme_alphatrade/public_head

    Head of the public site: theme_boost/head plus search engine and link preview tags. The preview tags come
    right after the title so link scrapers reading only the start of the page (WhatsApp) find them.
    doctype, htmlattributes and headhtml are computed in layout/frontpage.php (headhtml without Moodle's
    description and keywords).

    Example context (json):
    {
        "doctype": "<!DOCTYPE html>", "htmlattributes": "dir=\"ltr\" lang=\"fr\"", "headhtml": "",
        "output": {"favicon": "favicon.ico"},
        "seo": {"title": "Alpha Trade Academy", "description": "École de trading", "canonical": "https://example.com/",
            "sitename": "Alpha Trade Academy", "locale": "fr_FR", "image": "https://example.com/share-logo.jpg",
            "imagesize": 600, "imagealt": "Logo", "indexable": true, "llms": "https://example.com/llms.txt", "jsonld": "{}" }
    }
}}
{{{ doctype }}}
<html {{{ htmlattributes }}}>
<head>
    {{#seo}}
    <title>{{title}}</title>
    <meta name="description" content="{{description}}">
    <link rel="canonical" href="{{canonical}}">
    {{#indexable}}<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1">{{/indexable}}
    <meta property="og:type" content="website">
    <meta property="og:site_name" content="{{sitename}}">
    <meta property="og:locale" content="{{locale}}">
    <meta property="og:title" content="{{title}}">
    <meta property="og:description" content="{{description}}">
    <meta property="og:url" content="{{canonical}}">
    <meta property="og:image" content="{{image}}">
    <meta property="og:image:secure_url" content="{{image}}">
    <meta property="og:image:type" content="image/jpeg">
    <meta property="og:image:width" content="{{imagesize}}">
    <meta property="og:image:height" content="{{imagesize}}">
    <meta property="og:image:alt" content="{{imagealt}}">
    <meta name="twitter:card" content="summary">
    <meta name="twitter:title" content="{{title}}">
    <meta name="twitter:description" content="{{description}}">
    <meta name="twitter:image" content="{{image}}">
    <link rel="alternate" type="text/markdown" href="{{llms}}" title="llms.txt">
    <script type="application/ld+json">{{{jsonld}}}</script>
    {{/seo}}
    <link rel="shortcut icon" href="{{{ output.favicon }}}" />
    {{{ headhtml }}}
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
</head>
