{{!
    @template theme_alphatrade/tabbar

    Mobile bottom tab bar: 5 items only (Accueil, Parcours, Pratique, Backtest, Profil).

    Example context (json):
    {
        "nav": {
            "tabbar": [{"key": "home", "label": "Accueil", "icon": "ph-house", "url": "#", "active": true}]
        }
    }
}}
<nav class="alpha-tabbar d-lg-none d-print-none" aria-label="{{#str}}tabbar, theme_alphatrade{{/str}}">
    {{#nav.tabbar}}
        <a href="{{url}}" class="alpha-tabbar-item{{#active}} active{{/active}}"{{#active}} aria-current="page"{{/active}}>
            <i class="ph{{#active}}-fill{{/active}} {{icon}}" aria-hidden="true"></i>
            <span>{{label}}</span>
        </a>
    {{/nav.tabbar}}
</nav>
